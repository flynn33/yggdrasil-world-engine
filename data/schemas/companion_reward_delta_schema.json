{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yggdrasil.world.engine/schemas/companion_reward_delta_schema.json",
  "title": "Companion Reward Delta Schema",
  "type": "object",
  "required": [
    "schema_id",
    "version",
    "delta_id",
    "companion_ref",
    "delta_type",
    "source_refs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "const": "companion_reward_delta_schema"
    },
    "version": {
      "type": "string"
    },
    "delta_id": {
      "type": "string"
    },
    "companion_ref": {
      "type": "string"
    },
    "delta_type": {
      "enum": [
        "ancestral_memory_signal_added",
        "quest_signal_memory_recorded",
        "threshold_recognition_updated",
        "lore_recovery_signal_added",
        "bloodline_resonance_interpretation_updated",
        "manifestation_trigger_added",
        "manifestation_duration_extended",
        "manifestation_condition_satisfied",
        "wolf_resonance_summary_updated",
        "wolf_guidance_memory_recorded",
        "wolf_decoherence_recovery_signal_added"
      ]
    },
    "effect_summary": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
