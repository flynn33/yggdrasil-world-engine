{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yggdrasilworldengine.local/schemas/ability_artifact_binding_link_schema.json",
  "title": "AbilityArtifactBindingLink",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_id": {
      "const": "ywe.ability_artifact_binding_link.v1"
    },
    "schema_version": {
      "type": "string"
    },
    "link_id": {
      "type": "string"
    },
    "ability_id": {
      "type": "string"
    },
    "artifact_binding_ref": {
      "type": "object",
      "description": "Reference object",
      "additionalProperties": true,
      "properties": {
        "ref_id": {
          "type": "string"
        },
        "ref_type": {
          "type": "string"
        },
        "source_system": {
          "type": "string"
        }
      },
      "required": [
        "ref_id"
      ]
    },
    "binding_effect": {
      "type": "string",
      "enum": [
        "channel",
        "stabilize",
        "transform",
        "seal",
        "risk",
        "amplify",
        "interpret"
      ]
    },
    "consequence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Reference object",
        "additionalProperties": true,
        "properties": {
          "ref_id": {
            "type": "string"
          },
          "ref_type": {
            "type": "string"
          },
          "source_system": {
            "type": "string"
          }
        },
        "required": [
          "ref_id"
        ]
      }
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "link_id",
    "ability_id",
    "artifact_binding_ref",
    "binding_effect"
  ]
}
