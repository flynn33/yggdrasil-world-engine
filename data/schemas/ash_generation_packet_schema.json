{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_id": "ywe.schemas.ash_generation_packet",
  "version": "1.0.0",
  "authority": {
    "state_space": "F2^9",
    "codeword_set": "fixed_16_member_C_subset_F2_9",
    "transition_rule": "x_prime = x XOR c",
    "independent_meaningful_random_generation_allowed": false
  },
  "shared_provenance_fields": [
    "state_space",
    "normalized_state",
    "source_orbit_id",
    "active_codeword_sequence",
    "realm_identity",
    "diagnostic_ref",
    "generation_plan_ref",
    "cosmic_pattern_snapshot_ref",
    "source_ash_refs",
    "requested_manifest_kind",
    "worldstate_delta_policy",
    "ywe_context_packet_ref",
    "ash_state_snapshot_ref",
    "canonical_codeword_trace_ref"
  ],
  "records": {
    "AshState": {
      "required": [
        "state_space",
        "bits"
      ],
      "properties": {
        "state_space": "F2^9",
        "bits": "full_9_bit_vector"
      }
    },
    "CanonicalCodeword": {
      "required": [
        "state_space",
        "bits",
        "membership"
      ],
      "properties": {
        "state_space": "F2^9",
        "bits": "full_9_bit_vector",
        "membership": "must_be_member_of_canonical_C"
      }
    },
    "CosmicPatternSnapshot": {
      "required": [
        "snapshot_type",
        "state_space",
        "normalized_state",
        "source_orbit_id",
        "active_codeword_sequence",
        "realm_identity",
        "diagnostic_ref",
        "generation_plan_ref"
      ],
      "properties": {
        "snapshot_type": "CosmicPatternSnapshot",
        "state_space": "F2^9",
        "diagnostic_ref": "DiagnosticEnvelope",
        "generation_plan_ref": "GenerationPlan | null"
      }
    },
    "DiagnosticEnvelope": {
      "required": [
        "diagnostic_kind",
        "severity",
        "stage",
        "disposition",
        "subject_reference",
        "rule_ids"
      ],
      "properties": {
        "rule_id_taxonomy": "specs/interfaces/rule-id-taxonomy.md",
        "state_validity_schema": "specs/interfaces/diagnostic-schema.md"
      }
    },
    "GenerationPlan": {
      "required": [
        "plan_type",
        "plan_ref",
        "cosmic_pattern_snapshot_ref",
        "normalized_state",
        "diagnostic_ref",
        "artifacts",
        "metadata"
      ],
      "properties": {
        "plan_type": "GenerationPlan",
        "side_effects_allowed": false,
        "planner_contract": "GenerationPlanner",
        "emitter_contract": "ArtifactEmitter"
      }
    },
    "SourceASHRefs": {
      "required": [
        "cosmic_pattern_snapshot_ref",
        "diagnostic_ref",
        "generation_plan_ref",
        "normalized_state",
        "source_orbit_id",
        "active_codeword_sequence"
      ],
      "properties": {
        "truth_authority": "ASH Pattern System",
        "consumer_authority": "YWE domain interpretation"
      }
    },
    "YWEGenerationContextPacket": {
      "schema_ref": "ywe_generation_context_packet_schema.json",
      "role": "Carries YWE-side player, world, realm, perception, and consequence context into ASH-governed generation.",
      "required": [
        "packet_type",
        "version",
        "request_id",
        "trigger_kind",
        "requested_manifest_kind",
        "player_runtime_state_ref",
        "realm_context_ref",
        "worldstate_delta_refs",
        "perception_state_ref"
      ],
      "boundary": "Player and world context may influence generation requests but must not mutate ASH math."
    },
    "PlayerRuntimeState": {
      "schema_ref": "player_runtime_state_schema.json",
      "role": "Defines the player-specific runtime state referenced by YWEGenerationContextPacket.player_runtime_state_ref.",
      "required": [
        "record_type",
        "state_id",
        "player_ref",
        "current_phase",
        "current_leaf_branch_ref",
        "branch_generation_context_refs",
        "branch_event_refs",
        "authority_boundary",
        "ash_provenance",
        "update_policy"
      ],
      "boundary": "Player Runtime State may influence generation context and branch context but must not mutate ASH math, shared world truth, or base world ontology."
    },
    "PlayerRuntimeStateDelta": {
      "schema_ref": "player_runtime_state_schema.json",
      "role": "Records an auditable accepted, rejected, deferred, or merged change to PlayerRuntimeState.",
      "required": [
        "record_type",
        "delta_id",
        "target_state_ref",
        "trigger_trace_ref",
        "branch_event_ref",
        "changed_fields",
        "disposition",
        "diagnostic_ref",
        "generation_plan_ref",
        "source_ash_refs"
      ],
      "boundary": "Runtime deltas require player trace, branch evidence where relevant, diagnostic evidence, generation plan evidence, and source ASH references."
    },
    "ASHUpstreamGenerationEnvelope": {
      "schema_ref": "ash_upstream_generation_envelope_schema.json",
      "role": "Proves upstream ASH authority and binds diagnostics, plan, codeword trace, state snapshot, and provenance.",
      "required": [
        "packet_type",
        "version",
        "request_id",
        "requested_manifest_kind",
        "ywe_context_packet_ref",
        "ash_state_snapshot_ref",
        "canonical_codeword_trace_ref",
        "diagnostic_ref",
        "generation_plan_ref",
        "source_ash_refs",
        "authority_chain"
      ],
      "authority": "ASH Pattern System"
    },
    "YWEInterpretationPacket": {
      "schema_ref": "ywe_interpretation_packet_schema.json",
      "role": "Binds ASH-derived output to YWE domain interpretation and feature-engine handoff.",
      "required": [
        "packet_type",
        "version",
        "interpretation_id",
        "source_ash_refs",
        "diagnostic_ref",
        "generation_plan_ref",
        "realm_interpretation",
        "player_relevance",
        "manifestation_target",
        "allowed_feature_engine",
        "worldstate_delta_policy"
      ],
      "boundary": "YWE interprets ASH-derived pattern truth and does not create an independent symbolic grammar."
    },
    "PlayerActionTrace": {
      "schema_ref": "player_action_trace_schema.json",
      "role": "Records player action and consequence channels that may influence future ASH-governed context.",
      "required": [
        "trace_id",
        "player_ref",
        "action_kind",
        "local_context_ref",
        "timestamp_or_sequence_ref",
        "consequence_channels"
      ],
      "boundary": "Player actions influence future generation context; they do not mutate ASH math."
    },
    "ExplorationFrontierRequest": {
      "schema_ref": "exploration_frontier_request_schema.json",
      "role": "Represents unresolved frontier, threshold, thin-veil, or Yggdrasil-node generation triggers.",
      "required": [
        "request_id",
        "frontier_kind",
        "player_runtime_state_ref",
        "realm_context_ref",
        "known_boundary_refs",
        "requested_manifest_kind"
      ],
      "boundary": "Unresolved meaningful space requires ASH-governed generation before manifestation."
    },
    "FutureGenerationBiasUpdate": {
      "schema_ref": "future_generation_bias_update_schema.json",
      "role": "Records downstream consequence pressure for future ASH-governed generation context.",
      "required": [
        "bias_update_id",
        "source_worldstate_delta_ref",
        "affected_context_channels",
        "bias_strength",
        "expiration_policy",
        "authority_boundary"
      ],
      "boundary": "Bias updates alter downstream context only and never ASH canonical math."
    },
    "WorldstateDeltaPacket": {
      "schema_ref": "worldstate_location_mutation_schema.json",
      "role": "Records persistent Phase 11 consequence after meaningful resolution.",
      "required": [
        "record_type",
        "delta_id",
        "source_resolution_payload",
        "source_branch_event_ref",
        "player_runtime_state_ref",
        "current_leaf_branch_ref",
        "affected_location_refs",
        "location_mutation_refs",
        "consequence_domains",
        "authority_boundary",
        "ash_provenance"
      ],
      "boundary": "Worldstate deltas persist YWE consequence and may influence future generation context but must not mutate ASH math or base world ontology."
    },
    "LocationMutationState": {
      "schema_ref": "worldstate_location_mutation_schema.json",
      "role": "Stores scoped location state changed through accepted worldstate consequence.",
      "required": [
        "record_type",
        "location_state_id",
        "location_ref",
        "base_world_ref",
        "current_leaf_branch_ref",
        "status",
        "active_mutation_refs",
        "worldstate_delta_refs",
        "authority_boundary",
        "ash_provenance"
      ],
      "boundary": "Location mutation is scoped to player, branch, shared-world, or realm-local persistence and does not rewrite the nine-plane ontology."
    },
    "LocationMutationDelta": {
      "schema_ref": "worldstate_location_mutation_schema.json",
      "role": "Records an auditable change to LocationMutationState from an accepted WorldstateDeltaPacket.",
      "required": [
        "record_type",
        "mutation_delta_id",
        "target_location_state_ref",
        "source_worldstate_delta_ref",
        "source_player_runtime_state_ref",
        "mutation_kind",
        "diagnostic_ref",
        "generation_plan_ref",
        "source_ash_refs",
        "authority_boundary"
      ],
      "boundary": "LocationMutationDelta must remain downstream of worldstate evidence, diagnostics, and source ASH references."
    },
    "WorldstateMutationCommit": {
      "schema_ref": "worldstate_location_mutation_schema.json",
      "role": "Commits accepted worldstate and location mutation records with an explicit contradiction policy.",
      "required": [
        "record_type",
        "commit_id",
        "source_worldstate_delta_ref",
        "committed_record_refs",
        "commit_scope",
        "contradiction_policy",
        "authority_boundary",
        "ash_provenance"
      ],
      "boundary": "Commit records preserve append-first consequence and do not silently erase previous worldstate."
    },
    "DiagnosticNoOp": {
      "schema_ref": "worldstate_location_mutation_schema.json",
      "role": "Records a rejected or non-committing mutation request with diagnostic provenance.",
      "required": [
        "record_type",
        "no_op_id",
        "reason",
        "diagnostic_ref",
        "cosmic_pattern_snapshot_ref",
        "generation_plan_ref",
        "source_ash_refs"
      ],
      "boundary": "Unsupported or unlawful mutation requests fail explicitly instead of silently changing worldstate."
    },
    "SystemManifestHandoff": {
      "role": "Transfers a YWEInterpretationPacket to an allowed feature engine before host materialization.",
      "required": [
        "handoff_id",
        "requested_manifest_kind",
        "source_ash_refs",
        "diagnostic_ref",
        "generation_plan_ref",
        "allowed_feature_engine",
        "worldstate_delta_policy"
      ],
      "properties": {
        "planning_precedes_materialization": true,
        "host_adapter_may_author_truth": false,
        "feature_engine_claims_math_authority": false
      }
    },
    "AshStateSnapshot": {
      "role": "Names an ASH state snapshot emitted by the upstream authority for a generation request.",
      "required": [
        "snapshot_type",
        "state_space",
        "normalized_state",
        "source_orbit_id",
        "diagnostic_ref"
      ],
      "properties": {
        "snapshot_type": "AshStateSnapshot",
        "state_space": "F2^9",
        "truth_authority": "ASH Pattern System"
      }
    },
    "CanonicalCodewordTrace": {
      "role": "Names the ASH codeword sequence used by upstream generation planning.",
      "required": [
        "trace_type",
        "state_space",
        "active_codeword_sequence",
        "transition_rule",
        "diagnostic_ref"
      ],
      "properties": {
        "trace_type": "CanonicalCodewordTrace",
        "state_space": "F2^9",
        "transition_rule": "x_prime = x XOR c",
        "codeword_set": "fixed_16_member_C_subset_F2_9"
      }
    }
  },
  "authority_contract": "docs/architecture/ash_upstream_authority_contract.md",
  "architecture_law": [
    "ASH Pattern System",
    "Yggdrasil World Engine",
    "YWE game systems / feature engines",
    "platform-specific runtime implementations"
  ],
  "shared_generation_spine": [
    "RuntimeGenerationTrigger",
    "YWEGenerationContextPacket",
    "ASHUpstreamGenerationEnvelope",
    "YWEInterpretationPacket",
    "SystemManifestHandoff",
    "HostAdapterMaterializationRequest",
    "MaterializationResult",
    "ResolutionPayload",
    "WorldstateDeltaPacket|DiagnosticNoOp",
    "LocationMutationState|LocationMutationDelta|WorldstateMutationCommit",
    "FutureGenerationBiasUpdate"
  ]
}
