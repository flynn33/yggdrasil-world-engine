{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yggdrasil.world.engine/schemas/wolf_manifestation_rule_schema.json",
  "title": "Wolf Manifestation Rule Schema",
  "type": "object",
  "required": [
    "schema_id",
    "version",
    "rule_id",
    "eligible_companions",
    "trigger_conditions",
    "duration_policy",
    "forbidden_outputs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "const": "wolf_manifestation_rule_schema"
    },
    "version": {
      "type": "string"
    },
    "rule_id": {
      "type": "string"
    },
    "eligible_companions": {
      "type": "array",
      "items": {
        "enum": [
          "white_wolf",
          "dark_wolf"
        ]
      }
    },
    "trigger_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "duration_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "forbidden_outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
