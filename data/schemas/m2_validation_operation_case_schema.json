{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/m2_validation_operation_case_schema.json",
  "title": "M2 validation-operation case",
  "x-ywe-requirement-id": "YWE-REQ-0033",
  "description": "Cases execute validation tooling only; runtime recovery, event-log replay and persistence migration are outside this acceptance scope.",
  "oneOf": [
    {
      "$ref": "#/$defs/Recovery"
    },
    {
      "$ref": "#/$defs/Replay"
    },
    {
      "$ref": "#/$defs/Migration"
    }
  ],
  "$defs": {
    "FixtureBinding": {
      "type": "object",
      "required": [
        "path",
        "instance_pointer",
        "schema_id",
        "category",
        "expected_result",
        "expected_errors"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\).+$"
        },
        "instance_pointer": {
          "type": "string",
          "pattern": "^(?:/(?:[^~]|~[01])*)*$"
        },
        "schema_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "positive",
            "boundary",
            "reject",
            "recovery",
            "replay",
            "migration"
          ]
        },
        "expected_result": {
          "enum": [
            "accept",
            "reject"
          ]
        },
        "expected_errors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://ywe.local/schemas/fixture_catalog_schema.json#/$defs/error"
          }
        }
      },
      "additionalProperties": false
    },
    "Recovery": {
      "type": "object",
      "required": [
        "operation_id",
        "category",
        "validation_scope",
        "description",
        "fixture_id",
        "fixture_binding",
        "instance_sha256",
        "replacement",
        "expected_errors",
        "owner_bindings"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "const": "recovery"
        },
        "validation_scope": {
          "const": "schema_validation_operation"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "fixture_id": {
          "type": "string",
          "minLength": 1
        },
        "fixture_binding": {
          "$ref": "#/$defs/FixtureBinding"
        },
        "instance_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "replacement": {
          "type": "object",
          "required": [
            "pointer",
            "invalid_value",
            "restored_value"
          ],
          "properties": {
            "pointer": {
              "type": "string",
              "pattern": "^(?:/(?:[^~]|~[01])*)*$"
            },
            "invalid_value": {},
            "restored_value": {}
          },
          "additionalProperties": false
        },
        "expected_errors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://ywe.local/schemas/fixture_catalog_schema.json#/$defs/error"
          }
        },
        "owner_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "pointer",
              "value"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\).+$"
              },
              "pointer": {
                "type": "string",
                "pattern": "^(?:/(?:[^~]|~[01])*)*$"
              },
              "value": {}
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "Replay": {
      "type": "object",
      "required": [
        "operation_id",
        "category",
        "validation_scope",
        "description",
        "fixture_id",
        "fixture_binding",
        "instance_sha256"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "const": "replay"
        },
        "validation_scope": {
          "const": "schema_validation_operation"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "fixture_id": {
          "type": "string",
          "minLength": 1
        },
        "fixture_binding": {
          "$ref": "#/$defs/FixtureBinding"
        },
        "instance_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "Migration": {
      "type": "object",
      "required": [
        "operation_id",
        "category",
        "validation_scope",
        "description",
        "manifest_path",
        "migration_path",
        "source_revision",
        "migration_revision",
        "record_pointer",
        "record_sha256",
        "assertion_revision_pointer",
        "assertion_revision_sha256",
        "current_stage_sha256"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "const": "migration"
        },
        "validation_scope": {
          "const": "schema_validation_operation"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "manifest_path": {
          "const": "data/validation/m2_contract_migration_manifest.json"
        },
        "migration_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\).+$"
        },
        "source_revision": {
          "const": "b61b49eaf9dce30058a86b52fd4910087fc9e4da"
        },
        "migration_revision": {
          "const": "5b30dd50533d00b4c0852d45df3dfac61b3a4147"
        },
        "record_pointer": {
          "type": "string",
          "pattern": "^/migrations/(?:0|[1-9][0-9]*)$"
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "assertion_revision_pointer": {
          "type": "string",
          "pattern": "^/assertion_revisions/(?:0|[1-9][0-9]*)$"
        },
        "assertion_revision_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "current_stage_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "Stage": {
      "type": "object",
      "required": [
        "stage",
        "result",
        "errors"
      ],
      "properties": {
        "stage": {
          "enum": [
            "positive_control",
            "invalid_proposal",
            "restored_input",
            "first_validation",
            "replayed_validation",
            "protected_proof_reconstruction"
          ]
        },
        "result": {
          "enum": [
            "accept",
            "reject"
          ]
        },
        "errors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://ywe.local/schemas/fixture_catalog_schema.json#/$defs/error"
          }
        }
      },
      "additionalProperties": false
    },
    "Expectations": {
      "type": "object",
      "required": [
        "artifact_type",
        "artifact_version",
        "cases"
      ],
      "properties": {
        "artifact_type": {
          "const": "m2_validation_operation_expectations"
        },
        "artifact_version": {
          "const": "1.0.0"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "operation_id",
              "instance_pointer",
              "category",
              "expected_stages"
            ],
            "properties": {
              "operation_id": {
                "type": "string",
                "minLength": 1
              },
              "instance_pointer": {
                "type": "string",
                "pattern": "^/(?:recovery|replay|migration)/[^/]+$"
              },
              "category": {
                "enum": [
                  "recovery",
                  "replay",
                  "migration"
                ]
              },
              "expected_stages": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/Stage"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "Bundle": {
      "type": "object",
      "required": [
        "artifact_type",
        "artifact_version",
        "validation_scope",
        "recovery",
        "replay",
        "migration"
      ],
      "properties": {
        "artifact_type": {
          "const": "m2_validation_operation_cases"
        },
        "artifact_version": {
          "const": "1.0.0"
        },
        "validation_scope": {
          "const": "schema_validation_operation"
        },
        "recovery": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/Recovery"
          }
        },
        "replay": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/Replay"
          }
        },
        "migration": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/Migration"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
