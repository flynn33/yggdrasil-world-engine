{
  "schema_id": "ywe.npc_manifest_candidate.v1",
  "schema_version": "0.1.0",
  "status": "draft_for_phase_12_implementation",
  "authority": {
    "game": "Where Ravens Wait: Eternal Reckoning",
    "engine": "Yggdrasil World Engine",
    "foundation": "ASH Cosmological Model",
    "resilience_component": "ASH Pattern System"
  },
  "purpose": "Candidate NPC manifest emitted by Phase 12.",
  "required_fields": [
    "npc_candidate_id",
    "npc_role_class",
    "relation_graph_ref",
    "branch_context_ref",
    "location_context_ref",
    "pattern_vector_ref",
    "existence_potential_ref",
    "truth_scope",
    "self_reference_state_ref",
    "provenance",
    "exchange_target"
  ],
  "optional_fields": [
    "quest_anchor_refs",
    "lore_bearer_refs",
    "faction_interpreter_refs",
    "myth_seed_refs",
    "prophecy_pressure_refs"
  ],
  "forbidden": [
    "conscious_npc_without_self_reference",
    "npc_without_branch_or_location_context"
  ],
  "validation_notes": [
    "This is a code-agnostic contract schema unless the repository enforces a specific JSON Schema dialect.",
    "Field names may be adapted to existing repository conventions while preserving semantics.",
    "Generated content must be provenance-bearing, truth-scoped, and context-derived."
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/npc_manifest_candidate_schema.json",
  "title": "Npc Manifest Candidate Schema",
  "x-ywe-requirement-id": "YWE-M2-SCHEMA-DATA-SCHEMAS-NPC-MANIFEST-CANDIDATE-SCHEMA-JSON",
  "type": "object",
  "required": [
    "npc_candidate_id",
    "npc_role_class",
    "relation_graph_ref",
    "branch_context_ref",
    "location_context_ref",
    "pattern_vector_ref",
    "existence_potential_ref",
    "truth_scope",
    "self_reference_state_ref",
    "provenance",
    "exchange_target"
  ],
  "properties": {
    "branch_context_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "exchange_target": {
      "type": "string",
      "minLength": 1
    },
    "existence_potential_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "faction_interpreter_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "location_context_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "lore_bearer_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "myth_seed_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "npc_candidate_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "npc_role_class": {
      "type": "string",
      "minLength": 1
    },
    "pattern_vector_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "prophecy_pressure_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "quest_anchor_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "relation_graph_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "self_reference_state_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "truth_scope": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
