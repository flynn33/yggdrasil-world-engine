{
  "schema_id": "ywe.content_generation_batch.v1",
  "schema_version": "0.1.0",
  "status": "draft_for_phase_12_implementation",
  "authority": {
    "game": "Where Ravens Wait: Eternal Reckoning",
    "engine": "Yggdrasil World Engine",
    "foundation": "ASH Cosmological Model",
    "resilience_component": "ASH Pattern System"
  },
  "purpose": "Batch record for grouped quest, NPC, and lore candidates generated from the same context.",
  "required_fields": [
    "batch_id",
    "generation_context_refs",
    "candidate_refs",
    "shared_provenance_ref",
    "location_state_ref",
    "branch_reality_ref",
    "truth_scope_summary"
  ],
  "optional_fields": [
    "ravenfall_gate_example_refs",
    "batch_resolution_ref"
  ],
  "forbidden": [
    "batch_without_shared_context"
  ],
  "validation_notes": [
    "This is a code-agnostic contract schema unless the repository enforces a specific JSON Schema dialect.",
    "Field names may be adapted to existing repository conventions while preserving semantics.",
    "Generated content must be provenance-bearing, truth-scoped, and context-derived."
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/content_generation_batch_schema.json",
  "title": "Content Generation Batch Schema",
  "x-ywe-requirement-id": "YWE-M2-SCHEMA-DATA-SCHEMAS-CONTENT-GENERATION-BATCH-SCHEMA-JSON",
  "type": "object",
  "required": [
    "batch_id",
    "generation_context_refs",
    "candidate_refs",
    "shared_provenance_ref",
    "location_state_ref",
    "branch_reality_ref",
    "truth_scope_summary"
  ],
  "properties": {
    "batch_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "batch_resolution_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "branch_reality_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "candidate_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "generation_context_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "location_state_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "ravenfall_gate_example_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "shared_provenance_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "truth_scope_summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
