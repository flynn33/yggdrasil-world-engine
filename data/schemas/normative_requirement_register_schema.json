{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/normative_requirement_register_schema.json",
  "title": "YWE Normative Requirement Register",
  "type": "object",
  "required": [
    "artifact_type",
    "artifact_version",
    "schema_ref",
    "recorded_on",
    "repository_baseline",
    "policy_ref",
    "id_policy",
    "requirements",
    "summary"
  ],
  "properties": {
    "artifact_type": {"const": "normative_requirement_register"},
    "artifact_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "schema_ref": {"const": "data/schemas/normative_requirement_register_schema.json"},
    "recorded_on": {"type": "string", "format": "date"},
    "repository_baseline": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "policy_ref": {"const": "docs/governance/normative_language_and_requirement_id_policy.md"},
    "id_policy": {
      "type": "object",
      "required": [
        "series",
        "format",
        "allocation",
        "next_available_id",
        "renumbering_allowed",
        "reuse_allowed",
        "deletion_allowed",
        "terminal_records_retained"
      ],
      "properties": {
        "series": {"const": "YWE-REQ"},
        "format": {"const": "YWE-REQ-NNNN"},
        "allocation": {"const": "monotonic"},
        "next_available_id": {"type": "string", "pattern": "^YWE-REQ-[0-9]{4}$"},
        "renumbering_allowed": {"const": false},
        "reuse_allowed": {"const": false},
        "deletion_allowed": {"const": false},
        "terminal_records_retained": {"const": true}
      },
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "minItems": 18,
      "uniqueItems": true,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"requirement_id": {"const": "YWE-REQ-0001"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"requirement_id": {"const": "YWE-REQ-0002"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"requirement_id": {"const": "YWE-REQ-0003"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"requirement_id": {"const": "YWE-REQ-0004"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"requirement_id": {"const": "YWE-REQ-0005"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"requirement_id": {"const": "YWE-REQ-0006"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"requirement_id": {"const": "YWE-REQ-0007"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"requirement_id": {"const": "YWE-REQ-0008"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"requirement_id": {"const": "YWE-REQ-0009"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"requirement_id": {"const": "YWE-REQ-0010"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"requirement_id": {"const": "YWE-REQ-0011"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"requirement_id": {"const": "YWE-REQ-0012"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"requirement_id": {"const": "YWE-REQ-0013"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"requirement_id": {"const": "YWE-REQ-0014"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"requirement_id": {"const": "YWE-REQ-0015"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"requirement_id": {"const": "YWE-REQ-0016"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"requirement_id": {"const": "YWE-REQ-0017"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"requirement_id": {"const": "YWE-REQ-0018"}}}]}
      ],
      "items": {"$ref": "#/$defs/requirement"}
    },
    "summary": {
      "type": "object",
      "required": [
        "total_requirements",
        "active",
        "proposed",
        "terminal",
        "next_identifier"
      ],
      "properties": {
        "total_requirements": {"type": "integer", "minimum": 18},
        "active": {"type": "integer", "minimum": 0},
        "proposed": {"type": "integer", "minimum": 0},
        "terminal": {"type": "integer", "minimum": 0},
        "next_identifier": {"type": "string", "pattern": "^YWE-REQ-[0-9]{4}$"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "repository_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\).+$"
    },
    "requirement": {
      "type": "object",
      "required": [
        "requirement_id",
        "title",
        "normative_statement",
        "normative_level",
        "authority_node",
        "scope_partition",
        "verification_refs",
        "aliases",
        "supersedes",
        "status",
        "introduced_milestone",
        "owner_role",
        "decision_refs",
        "source_refs"
      ],
      "properties": {
        "requirement_id": {"type": "string", "pattern": "^YWE-REQ-[0-9]{4}$"},
        "title": {"type": "string", "minLength": 5},
        "normative_statement": {
          "type": "string",
          "minLength": 20,
          "pattern": "\\b(?:MUST|SHOULD|MAY)\\b"
        },
        "normative_level": {
          "enum": ["MUST", "MUST_NOT", "SHOULD", "SHOULD_NOT", "MAY", "mixed"]
        },
        "authority_node": {
          "enum": [
            "ash_cosmological_model",
            "ywe_core",
            "ywe_extension_profile",
            "wrw_reference_profile",
            "shared_worldstate",
            "branch_local_state",
            "player_local_state",
            "perception_social_interpretation",
            "host_materialization",
            "forsetti_lifecycle_governance"
          ]
        },
        "scope_partition": {
          "enum": [
            "ywe_core",
            "ywe_extension_profile",
            "ash_dependency_material",
            "wrw_reference_profile",
            "governance_validation",
            "historical_evidence",
            "later_release_work"
          ]
        },
        "verification_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repository_ref"}
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "supersedes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^YWE-REQ-[0-9]{4}$"}
        },
        "status": {"enum": ["proposed", "active", "superseded", "retired"]},
        "introduced_milestone": {"type": "string", "pattern": "^M(?:[0-9]|10)$"},
        "owner_role": {"type": "string", "minLength": 3},
        "decision_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^ADR-[0-9]{4}$"}
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repository_ref"}
        },
        "superseded_by": {"type": "string", "pattern": "^YWE-REQ-[0-9]{4}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "superseded"}}, "required": ["status"]},
          "then": {"required": ["superseded_by"]},
          "else": {"not": {"required": ["superseded_by"]}}
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
