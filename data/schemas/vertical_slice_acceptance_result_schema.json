{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yggdrasilworldengine.local/schemas/vertical_slice_acceptance_result.json",
  "title": "vertical_slice_acceptance_result",
  "description": "YWE Phase 17 schema for vertical_slice_acceptance_result.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_id": {
      "type": "string",
      "minLength": 1
    },
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_ref": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "blocked",
        "needs_review"
      ]
    },
    "gates_passed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gates_failed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "issue_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "canon_violations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_id",
    "result_id",
    "trace_ref",
    "status",
    "gates_passed",
    "gates_failed",
    "issue_refs",
    "canon_violations"
  ]
}
