{
  "schema_id": "ywe.branch_generation_context.v1",
  "schema_version": "0.1.0",
  "status": "draft_for_phase_9",
  "description": "Gathers all player, world, location, and cosmology context needed to instantiate or mutate a leaf branch reality.",
  "authority": {
    "game": "Where Ravens Wait: Eternal Reckoning",
    "engine": "Yggdrasil World Engine",
    "foundation": "ASH Cosmological Model",
    "stability_component": "ASH Pattern System"
  },
  "required_fields": [
    "branch_generation_context_id",
    "branch_event_ref",
    "base_world_ref",
    "parent_branch_ref",
    "player_context",
    "world_context",
    "location_context",
    "cosmology_context",
    "asp_component_context",
    "diagnostic_refs",
    "future_generation_bias_refs"
  ],
  "player_context_fields": [
    "player_runtime_state_ref",
    "plane_attunement_ref",
    "bloodline_resonance_ref",
    "wolf_resonance_ref",
    "perception_state_ref",
    "quest_history_refs",
    "artifact_binding_refs",
    "myth_exposure_refs",
    "prophecy_pressure_refs"
  ],
  "world_context_fields": [
    "worldstate_delta_refs",
    "faction_topology_ref",
    "active_myth_refs",
    "active_prophecy_refs"
  ],
  "location_context_fields": [
    "location_state_ref",
    "location_mutation_refs",
    "threshold_status_ref",
    "plane_pressure_ref"
  ],
  "cosmology_context_fields": [
    "axiom_diagnostic_refs",
    "existence_potential_ref",
    "pattern_vector_refs",
    "base_world_ontology_ref"
  ],
  "asp_component_context_fields": [
    "diagnostic_ref",
    "recovery_status_ref",
    "conformance_ref",
    "containment_ref"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/branch_generation_context_schema.json",
  "title": "Branch Generation Context Schema",
  "x-ywe-requirement-id": "YWE-M2-SCHEMA-DATA-SCHEMAS-BRANCH-GENERATION-CONTEXT-SCHEMA-JSON",
  "type": "object",
  "required": [
    "branch_generation_context_id",
    "branch_event_ref",
    "base_world_ref",
    "parent_branch_ref",
    "player_context",
    "world_context",
    "location_context",
    "cosmology_context",
    "asp_component_context",
    "diagnostic_refs",
    "future_generation_bias_refs"
  ],
  "properties": {
    "asp_component_context": {
      "type": "string",
      "minLength": 1
    },
    "base_world_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "branch_event_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "branch_generation_context_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "cosmology_context": {
      "type": "string",
      "minLength": 1
    },
    "diagnostic_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "future_generation_bias_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "location_context": {
      "type": "string",
      "minLength": 1
    },
    "parent_branch_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "player_context": {
      "type": "string",
      "minLength": 1
    },
    "world_context": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
