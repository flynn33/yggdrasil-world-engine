{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/fixture_catalog_schema.json",
  "title": "Explicit executable fixture bindings",
  "x-ywe-requirement-id": "YWE-REQ-0020",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_ref", "artifact_type", "artifact_version", "fixtures"],
  "properties": {
    "schema_ref": {"const": "data/schemas/fixture_catalog_schema.json"},
    "artifact_type": {"const": "ywe_fixture_catalog"},
    "artifact_version": {"const": "1.0.0"},
    "fixtures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fixture"}}
  },
  "$defs": {
    "pointer": {"type": "string", "pattern": "^(?:/(?:[^~]|~[01])*)*$"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_id", "instance_pointer", "schema_pointer"],
      "properties": {
        "error_id": {"type": "string", "pattern": "^JSON_SCHEMA_[A-Z]+$"},
        "instance_pointer": {"$ref": "#/$defs/pointer"},
        "schema_pointer": {"$ref": "#/$defs/pointer"},
        "missing_properties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      },
      "allOf": [{
        "if": {"properties": {"error_id": {"const": "JSON_SCHEMA_REQUIRED"}}},
        "then": {"required": ["missing_properties"]}
      }]
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "path", "instance_pointer", "schema_id", "category", "expected_result", "expected_errors"],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "path": {"type": "string", "minLength": 1},
        "instance_pointer": {"$ref": "#/$defs/pointer"},
        "schema_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:.+$"},
        "category": {"enum": ["positive", "boundary", "reject", "recovery", "replay", "migration"]},
        "expected_result": {"enum": ["accept", "reject"]},
        "expected_errors": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/error"}},
        "description": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"expected_result": {"const": "accept"}}},
          "then": {"properties": {"expected_errors": {"maxItems": 0}, "category": {"not": {"const": "reject"}}}},
          "else": {"properties": {"expected_errors": {"minItems": 1}, "category": {"const": "reject"}}}
        }
      ]
    }
  }
}
