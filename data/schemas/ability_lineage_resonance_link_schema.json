{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yggdrasilworldengine.local/schemas/ability_lineage_resonance_link_schema.json",
  "title": "AbilityLineageResonanceLink",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_id": {
      "const": "ywe.ability_lineage_resonance_link.v1"
    },
    "schema_version": {
      "type": "string"
    },
    "link_id": {
      "type": "string"
    },
    "ability_id": {
      "type": "string"
    },
    "lineage_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Reference object",
        "additionalProperties": true,
        "properties": {
          "ref_id": {
            "type": "string"
          },
          "ref_type": {
            "type": "string"
          },
          "source_system": {
            "type": "string"
          }
        },
        "required": [
          "ref_id"
        ]
      },
      "minItems": 1
    },
    "resonance_thresholds": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "destiny_lock": {
      "type": "boolean",
      "description": "Must normally be false; lineage opens doors but does not determine destiny."
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "link_id",
    "ability_id",
    "lineage_refs"
  ]
}
