{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_id": "ywe.engine_authority_stack.v1",
  "title": "YWE Engine Authority Stack",
  "type": "object",
  "required": [
    "ash_model_of_universe",
    "yggdrasil_world_engine",
    "ash_pattern_system"
  ],
  "properties": {
    "ash_model_of_universe": {
      "type": "object",
      "required": [
        "role",
        "foundation_type"
      ],
      "properties": {
        "role": {
          "const": "mathematical_and_ontological_foundation"
        },
        "foundation_type": {
          "const": "engine_simulation_layer"
        },
        "layers": {
          "type": "array",
          "items": {
            "enum": [
              "archetype",
              "symbolic",
              "harmonic"
            ]
          }
        }
      }
    },
    "yggdrasil_world_engine": {
      "type": "object",
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "const": "agnostic_simulation_framework"
        }
      }
    },
    "ash_pattern_system": {
      "type": "object",
      "required": [
        "role",
        "responsibilities"
      ],
      "properties": {
        "role": {
          "const": "engine_component"
        },
        "responsibilities": {
          "type": "array",
          "items": {
            "enum": [
              "pattern_integrity",
              "diagnostics",
              "recovery",
              "containment",
              "conformance",
              "code_resilience",
              "update_safety",
              "patch_stability",
              "drift_detection",
              "generation_plan_consistency"
            ]
          }
        }
      }
    },
    "profile_layer": {
      "type": "object",
      "required": [
        "name",
        "role"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "game_narrative_layer",
            "simulation_profile_layer",
            "extension_profile_layer"
          ]
        }
      }
    },
    "game_layer": {
      "type": "object",
      "deprecated": true,
      "description": "Deprecated compatibility property for profile_layer; no named game is required by YWE Core.",
      "required": [
        "name",
        "role"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "game_narrative_layer",
            "simulation_profile_layer",
            "extension_profile_layer"
          ]
        }
      }
    }
  }
}
