{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/contract_catalog_schema.json",
  "title": "Repository offline schema catalog",
  "x-ywe-requirement-id": "YWE-REQ-0019",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_ref", "artifact_type", "artifact_version", "schemas"],
  "properties": {
    "schema_ref": {"const": "data/schemas/contract_catalog_schema.json"},
    "artifact_type": {"const": "ywe_contract_catalog"},
    "artifact_version": {"const": "1.0.0"},
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_id", "path"],
        "properties": {
          "schema_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^#]+$"},
          "path": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
