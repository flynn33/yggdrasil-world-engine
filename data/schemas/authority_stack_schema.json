{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/authority_stack_schema.json",
  "title": "YWE Authority Stack Schema",
  "type": "object",
  "required": [
    "engine_layer",
    "foundation_layer",
    "component_layer"
  ],
  "properties": {
    "profile_layer": {
      "type": "string",
      "minLength": 1,
      "description": "Optional profile-supplied game or simulation layer identifier."
    },
    "game_layer": {
      "type": "string",
      "minLength": 1,
      "deprecated": true,
      "description": "Deprecated compatibility name for profile_layer; no specific game is required by YWE Core."
    },
    "engine_layer": {
      "const": "Yggdrasil World Engine"
    },
    "foundation_layer": {
      "const": "ASH Cosmological Model"
    },
    "component_layer": {
      "const": "ASH Pattern System"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "x-ywe-legacy-schema-id": "ywe.authority_stack.schema.v1"
}
