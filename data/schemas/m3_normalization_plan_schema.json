          }
        },
        {
          "properties": {
            "decision": {
              "const": "NOT_NORMALIZABLE"
            },
            "reason_code": {
              "const": "NORMALIZATION_NO_TARGET"
            },
            "eligible_targets_complete": {
              "const": true
            },
            "eligible_targets": {
              "type": "array",
              "minItems": 0,
              "items": false,
              "maxItems": 0
            },
            "selected_target": {
              "type": "null"
            },
            "codeword_chain": {
              "type": "array",
              "minItems": 0,
              "items": false,
              "maxItems": 0
            }
          }
        },
        {
          "properties": {
            "decision": {
              "const": "BLOCKED"
            },
            "reason_code": {
              "enum": [
                "NORMALIZATION_INPUT_REJECTED",
                "NORMALIZATION_PROFILE_UNAVAILABLE"
              ]
            },
            "eligible_targets_complete": {
              "const": false
            },
            "eligible_targets": {
              "type": "array",
              "minItems": 0,
              "items": false,
              "maxItems": 0
