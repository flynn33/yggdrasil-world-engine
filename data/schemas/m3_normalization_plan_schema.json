{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/m3_normalization_plan_schema.json",
  "title": "M3 N1 semantic normalization plan packet",
  "description": "Adopted YWE N1 portable plan format with exact headers, bounded immutable-value representations and structural decision branches. Runtime validates the complete original diagnosis, full profile/source equality, sorted complete orbit intersection, identity-first policy, selected target and requested XOR proof; structural acceptance is not execution or acknowledgement evidence.",
  "x-ywe-requirement-id": "YWE-REQ-0040",
  "$ref": "#/$defs/NormalizationPlan",
  "$defs": {
    "NormalizationPolicyBinding": {
      "type": "object",
      "required": [
        "policy_id",
        "policy_version",
        "source_reference",
        "source_sha256"
      ],
      "properties": {
        "policy_id": {
          "const": "YWE-NORMALIZE-LEXICOGRAPHIC-001"
        },
        "policy_version": {
          "const": "1.0.0"
        },
        "source_reference": {
          "const": "docs/architecture/m3_normalization_policy.md"
        },
        "source_sha256": {
          "const": "804eec92cf52b465b7aaf0cb5f139f581ac2899d13203a8c4cfe9f4d7579c383"
        }
      },
      "additionalProperties": false,
      "x-ywe-requirement-id": "YWE-REQ-0040"
    },
