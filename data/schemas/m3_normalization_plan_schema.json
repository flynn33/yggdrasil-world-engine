        "eligible_targets",
        "selected_target",
        "codeword_chain",
        "reason_code"
      ],
      "properties": {
        "schema_ref": {
          "const": "data/schemas/m3_normalization_plan_schema.json"
        },
        "artifact_type": {
          "const": "ywe_state_normalization_plan"
        },
        "artifact_version": {
          "const": "1.0.0"
        },
        "plan_reference": {
          "$ref": "https://ywe.local/schemas/m3_state_assessment_schema.json#/$defs/Identifier"
        },
        "evidence_reference": {
          "$ref": "https://ywe.local/schemas/m3_state_assessment_schema.json#/$defs/Identifier"
        },
        "policy_binding": {
          "$ref": "#/$defs/NormalizationPolicyBinding"
        },
        "original_diagnosis": {
          "$ref": "https://ywe.local/schemas/m3_state_assessment_schema.json#/$defs/StateDiagnosis"
        },
        "decision": {
          "enum": [
            "ALREADY_VALID",
            "PLAN_READY",
            "NOT_NORMALIZABLE",
            "BLOCKED"
          ]
        },
        "eligible_targets_complete": {
          "type": "boolean"
        },
        "eligible_targets": {
          "$ref": "#/$defs/EligibleTargets"
        },
        "selected_target": {
          "oneOf": [
            {
              "$ref": "https://ywe.local/schemas/m3_state_assessment_schema.json#/$defs/AshState"
            },
            {
              "type": "null"
            }
          ]
        },
        "codeword_chain": {
          "$ref": "#/$defs/CodewordChain"
        },
        "reason_code": {
          "enum": [
            "NORMALIZATION_ALREADY_VALID",
            "NORMALIZATION_PLAN_READY",
            "NORMALIZATION_NO_TARGET",
            "NORMALIZATION_INPUT_REJECTED",
            "NORMALIZATION_PROFILE_UNAVAILABLE"
          ]
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "decision": {
              "const": "ALREADY_VALID"
            },
            "reason_code": {
              "const": "NORMALIZATION_ALREADY_VALID"
