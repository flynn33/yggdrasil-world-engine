        },
        "source_worldstate_delta_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_quest_resolution_payload_ref": {
          "type": "string",
          "minLength": 1
        },
        "eligible_faction_refs": {
          "$ref": "#/$defs/NonEmptyStringRefList"
        },
        "diagnostic_ref": {
          "type": "string",
          "minLength": 1
        },
        "generation_plan_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_ash_refs": {
          "$ref": "#/$defs/NonEmptyStringRefList"
        },
        "authority_boundary": {
          "$ref": "#/$defs/AuthorityBoundary"
        }
      }
    },
    "MythRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "version",
        "myth_record_id",
        "myth_seed_candidate_ref",
        "source_worldstate_delta_ref",
        "myth_lines",
        "social_distribution_delta_ref",
        "factual_world_truth_rewrite_allowed",
        "authority_boundary",
        "ash_provenance"
      ],
      "properties": {
        "record_type": {
          "const": "MythRecord"
        },
        "version": {
          "type": "string",
          "const": "1.0.0"
        },
        "myth_record_id": {
          "type": "string",
          "minLength": 1
        },
        "myth_seed_candidate_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_worldstate_delta_ref": {
          "type": "string",
          "minLength": 1
        },
        "myth_lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/MythLine"
          }
        },
