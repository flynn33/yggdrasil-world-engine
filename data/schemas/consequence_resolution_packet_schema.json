{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.yggdrasilworldengine.local/ywe.consequence_resolution_packet.v1.json",
  "title": "ywe.consequence_resolution_packet.v1",
  "description": "Aggregates all systemic consequence deltas produced by quest resolution.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "packet_id": {
      "type": "string"
    },
    "quest_ref": {
      "type": "string"
    },
    "completion_mode": {
      "type": "string",
      "enum": [
        "reveal_oath",
        "conceal_oath",
        "bind_oath",
        "study_oath",
        "weaponize_oath",
        "restore_relation",
        "contain_anomaly",
        "stabilize_threshold",
        "refuse_resolution",
        "custom"
      ]
    },
    "delta_bundle_ref": {
      "type": "string"
    },
    "delta_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnostic_noop_ref": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "ash_model_ref": {
          "type": "string"
        },
        "ash_pattern_system_diagnostic_ref": {
          "type": "string"
        },
        "quest_manifest_ref": {
          "type": "string"
        },
        "player_action_trace_ref": {
          "type": "string"
        },
        "branch_event_ref": {
          "type": "string"
        },
        "worldstate_delta_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "packet_id",
    "quest_ref",
    "completion_mode",
    "provenance"
  ]
}
