{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yggdrasil.world.engine/schemas/raven_companion_state_schema.json",
  "title": "Raven Companion State Schema",
  "type": "object",
  "required": [
    "schema_id",
    "version",
    "companion_id",
    "display_name",
    "presence_rule",
    "runtime_status",
    "bound_player_identity",
    "identity_layers",
    "primary_functions",
    "absence_rule",
    "source_refs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "const": "raven_companion_state_schema"
    },
    "version": {
      "type": "string"
    },
    "companion_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "presence_rule": {
      "const": "always_with_player"
    },
    "runtime_status": {
      "enum": [
        "active",
        "offscreen_active",
        "story_separated",
        "noninteractive_presentation"
      ]
    },
    "bound_player_identity": {
      "type": "string"
    },
    "campaign_scope": {
      "type": "string"
    },
    "identity_layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "primary_functions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "absence_rule": {
      "type": "string"
    },
    "state_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
