{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/scope_partition_manifest_schema.json",
  "title": "YWE Repository Scope Partition Manifest",
  "type": "object",
  "required": [
    "schema_ref",
    "artifact_type",
    "artifact_version",
    "repository_baseline",
    "classification_manifest_ref",
    "policy_ref",
    "tracked_path_snapshot",
    "partitions",
    "matching_policy",
    "ordered_rules",
    "overrides",
    "coverage"
  ],
  "properties": {
    "schema_ref": {"const": "data/schemas/scope_partition_manifest_schema.json"},
    "artifact_type": {"const": "repository_scope_partition_manifest"},
    "artifact_version": {"$ref": "#/$defs/semantic_version"},
    "repository_baseline": {"$ref": "#/$defs/semantic_version"},
    "classification_manifest_ref": {"const": "data/governance/artifact_classification_manifest.json"},
    "policy_ref": {"$ref": "#/$defs/repository_path"},
    "tracked_path_snapshot": {"$ref": "#/$defs/path_snapshot"},
    "partitions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/partition_definition"}
    },
    "matching_policy": {"$ref": "#/$defs/matching_policy"},
    "ordered_rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rule"}
    },
    "overrides": {
      "type": "array",
      "items": {"$ref": "#/$defs/override"}
    },
    "coverage": {
      "type": "object",
      "required": ["counts_by_partition"],
      "properties": {
        "counts_by_partition": {"$ref": "#/$defs/partition_counts"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "semantic_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "milestone": {"type": "string", "pattern": "^M(?:[1-9]|10)$"},
    "partition": {
      "enum": [
        "ywe_core",
        "ywe_extension_profile",
        "ash_dependency_material",
        "wrw_reference_profile",
        "governance_validation",
        "historical_evidence",
        "later_release_work"
      ]
    },
    "path_snapshot": {
      "type": "object",
      "required": ["source", "path_count", "path_digest", "digest_algorithm"],
      "properties": {
        "source": {"const": "git_tracked_and_nonignored_untracked"},
        "path_count": {"type": "integer", "minimum": 1},
        "path_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "digest_algorithm": {"const": "sha256_sorted_posix_paths_nul"}
      },
      "additionalProperties": false
    },
    "matching_policy": {
      "type": "object",
      "required": [
        "path_style",
        "case_sensitive",
        "overrides_terminal",
        "fail_on_zero_matches",
        "fail_on_multiple_matches",
        "fail_on_path_snapshot_drift"
      ],
      "properties": {
        "path_style": {"const": "repository_relative_posix"},
        "case_sensitive": {"const": true},
        "overrides_terminal": {"const": true},
        "fail_on_zero_matches": {"const": true},
        "fail_on_multiple_matches": {"const": true},
        "fail_on_path_snapshot_drift": {"const": true}
      },
      "additionalProperties": false
    },
    "partition_definition": {
      "type": "object",
      "required": ["id", "definition"],
      "properties": {
        "id": {"$ref": "#/$defs/partition"},
        "definition": {"type": "string", "minLength": 10}
      },
      "additionalProperties": false
    },
    "common_assignment": {
      "type": "object",
      "required": ["primary_partition", "owner_role", "governing_source", "rationale"],
      "properties": {
        "primary_partition": {"$ref": "#/$defs/partition"},
        "owner_role": {"type": "string", "minLength": 3},
        "governing_source": {"$ref": "#/$defs/repository_path"},
        "rationale": {"type": "string", "minLength": 10},
        "future_milestone": {"$ref": "#/$defs/milestone"},
        "debt_ref": {"$ref": "#/$defs/debt_id"},
        "normative_scope_exception": {"$ref": "#/$defs/normative_scope_exception"},
        "secondary_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"primary_partition": {"const": "later_release_work"}}},
          "then": {"required": ["future_milestone", "debt_ref"]}
        },
        {
          "if": {"required": ["normative_scope_exception"]},
          "then": {
            "properties": {
              "primary_partition": {"enum": ["historical_evidence", "later_release_work"]}
            }
          }
        }
      ]
    },
    "rule": {
      "allOf": [
        {"$ref": "#/$defs/common_assignment"},
        {
          "type": "object",
          "required": ["priority", "id", "include", "exclude"],
          "properties": {
            "priority": {"type": "integer", "minimum": 0},
            "id": {"type": "string", "pattern": "^SPR-[0-9]{3,}$"},
            "include": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "exclude": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "override": {
      "allOf": [
        {"$ref": "#/$defs/common_assignment"},
        {
          "type": "object",
          "required": ["path"],
          "properties": {"path": {"$ref": "#/$defs/repository_path"}}
        }
      ],
      "unevaluatedProperties": false
    },
    "partition_counts": {
      "type": "object",
      "required": [
        "ywe_core",
        "ywe_extension_profile",
        "ash_dependency_material",
        "wrw_reference_profile",
        "governance_validation",
        "historical_evidence",
        "later_release_work"
      ],
      "properties": {
        "ywe_core": {"type": "integer", "minimum": 0},
        "ywe_extension_profile": {"type": "integer", "minimum": 0},
        "ash_dependency_material": {"type": "integer", "minimum": 0},
        "wrw_reference_profile": {"type": "integer", "minimum": 0},
        "governance_validation": {"type": "integer", "minimum": 0},
        "historical_evidence": {"type": "integer", "minimum": 0},
        "later_release_work": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "debt_id": {
      "type": "string",
      "pattern": "^QD-(?:[0-9]{3,}|PH-[a-f0-9]{8,64}|OW-[0-9]{3,})$"
    },
    "normative_scope_exception": {
      "type": "object",
      "required": ["rationale", "authority_ref"],
      "properties": {
        "rationale": {"type": "string", "minLength": 10},
        "authority_ref": {"$ref": "#/$defs/repository_path"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
