{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/ywe.future_generation_bias_update.v1.json",
  "title": "Future Generation Bias Update",
  "description": "Records how consequences influence future content eligibility and weighting.",
  "type": "object",
  "required": [
    "schema_id",
    "version",
    "bias_update_id",
    "source_refs",
    "bias_targets",
    "validation"
  ],
  "properties": {
    "schema_id": {
      "const": "ywe.future_generation_bias_update.v1"
    },
    "version": {
      "type": "string"
    },
    "bias_update_id": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "object",
      "properties": {
        "worldstate_delta_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "location_state_record_ref": {
          "type": "string"
        },
        "location_branch_overlay_ref": {
          "type": "string"
        },
        "player_state_snapshot_ref": {
          "type": "string"
        },
        "branch_event_ref": {
          "type": "string"
        },
        "ash_pattern_diagnostic_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "bias_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target_system",
          "bias_kind"
        ],
        "properties": {
          "target_system": {
            "enum": [
              "quest_generation",
              "npc_generation",
              "lore_generation",
              "artifact_eligibility",
              "creature_ecology",
              "myth_seed",
              "prophecy_pressure",
              "location_access",
              "ability_pressure",
              "wolf_manifestation",
              "bloodline_echo",
              "faction_attention"
            ]
          },
          "bias_kind": {
            "enum": [
              "increase_eligibility",
              "decrease_eligibility",
              "open_candidate",
              "close_candidate",
              "increase_pressure",
              "decrease_pressure",
              "mark_deferred"
            ]
          },
          "weight": {
            "type": "number"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "does_not_materialize_content",
        "has_worldstate_or_noop_source"
      ],
      "properties": {
        "does_not_materialize_content": {
          "const": true
        },
        "has_worldstate_or_noop_source": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
