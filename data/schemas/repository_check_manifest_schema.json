{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/repository_check_manifest_schema.json",
  "title": "YWE Repository Check Manifest",
  "type": "object",
  "required": ["artifact_type", "artifact_version", "roadmap_ref", "checks"],
  "properties": {
    "artifact_type": {"const": "repository_check_manifest"},
    "artifact_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "roadmap_ref": {"type": "string", "minLength": 1},
    "checks": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "name", "command", "groups", "roadmap_milestones", "contexts", "blocking"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
          "name": {"type": "string", "minLength": 4},
          "command": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string", "minLength": 1}
          },
          "groups": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]+$"}
          },
          "roadmap_milestones": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^M(?:[0-9]|10)$"}
          },
          "contexts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["always", "local", "pull_request", "push", "manual"]}
          },
          "blocking": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
