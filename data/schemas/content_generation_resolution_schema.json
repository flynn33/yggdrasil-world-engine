{
  "schema_id": "ywe.content_generation_resolution.v1",
  "schema_version": "0.1.0",
  "status": "draft_for_phase_12_implementation",
  "authority": {
    "game": "Where Ravens Wait: Eternal Reckoning",
    "engine": "Yggdrasil World Engine",
    "foundation": "ASH Cosmological Model",
    "resilience_component": "ASH Pattern System"
  },
  "purpose": "Resolution record for accepting, rejecting, or deferring generated content candidates.",
  "required_fields": [
    "resolution_id",
    "candidate_ref",
    "decision",
    "decision_reason",
    "validation_results",
    "truth_scope",
    "exchange_result"
  ],
  "optional_fields": [
    "rejection_reason_ref",
    "diagnostic_noop_ref",
    "future_generation_bias_ref"
  ],
  "forbidden": [
    "silent_acceptance",
    "silent_rejection"
  ],
  "validation_notes": [
    "This is a code-agnostic contract schema unless the repository enforces a specific JSON Schema dialect.",
    "Field names may be adapted to existing repository conventions while preserving semantics.",
    "Generated content must be provenance-bearing, truth-scoped, and context-derived."
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/content_generation_resolution_schema.json",
  "title": "Content Generation Resolution Schema",
  "x-ywe-requirement-id": "YWE-M2-SCHEMA-DATA-SCHEMAS-CONTENT-GENERATION-RESOLUTION-SCHEMA-JSON",
  "type": "object",
  "required": [
    "resolution_id",
    "candidate_ref",
    "decision",
    "decision_reason",
    "validation_results",
    "truth_scope",
    "exchange_result"
  ],
  "properties": {
    "candidate_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "decision_reason": {
      "type": "string",
      "minLength": 1
    },
    "diagnostic_noop_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "exchange_result": {
      "type": "string",
      "minLength": 1
    },
    "future_generation_bias_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "rejection_reason_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "resolution_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "truth_scope": {
      "type": "string",
      "minLength": 1
    },
    "validation_results": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
