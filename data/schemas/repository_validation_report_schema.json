{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/repository_validation_report_schema.json",
  "title": "Executed repository validation report",
  "x-ywe-requirement-id": "YWE-REQ-0023",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "artifact_version", "execution_complete", "revision", "context", "check_catalog_sha256", "selection", "offline", "dirty_before", "dirty_after", "tool_versions", "results", "summary"],
  "properties": {
    "artifact_type": {"const": "ywe_repository_validation_report"},
    "artifact_version": {"const": "1.0.0"},
    "execution_complete": {"type": "boolean"},
    "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "context": {"enum": ["local", "pull_request", "push", "manual"]},
    "check_catalog_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "selection": {
      "type": "object", "additionalProperties": false, "required": ["groups", "check_ids"],
      "properties": {"groups": {"$ref": "#/$defs/strings"}, "check_ids": {"$ref": "#/$defs/strings"}}
    },
    "offline": {
      "type": "object", "additionalProperties": false, "required": ["requested", "git_allow_protocol"],
      "properties": {"requested": {"type": "boolean"}, "git_allow_protocol": {"enum": ["file", null]}}
    },
    "dirty_before": {"$ref": "#/$defs/strings"},
    "dirty_after": {"$ref": "#/$defs/strings"},
    "tool_versions": {
      "type": "object", "additionalProperties": false, "required": ["python", "jsonschema", "PyYAML", "referencing"],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "jsonschema": {"type": ["string", "null"], "minLength": 1},
        "PyYAML": {"type": ["string", "null"], "minLength": 1},
        "referencing": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "results": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["check_id", "blocking", "return_code"],
        "properties": {"check_id": {"type": "string", "minLength": 1}, "blocking": {"type": "boolean"}, "return_code": {"type": "integer"}}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false, "required": ["passed", "blocking_failures", "advisories"],
      "properties": {"passed": {"$ref": "#/$defs/count"}, "blocking_failures": {"$ref": "#/$defs/count"}, "advisories": {"$ref": "#/$defs/count"}}
    }
  },
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "count": {"type": "integer", "minimum": 0}
  }
}
