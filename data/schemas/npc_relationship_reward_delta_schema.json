{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.yggdrasilworldengine.local/ywe.npc_relationship_reward_delta.v1.json",
  "title": "ywe.npc_relationship_reward_delta.v1",
  "description": "Updates NPC relationship and memory state.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "delta_id": {
      "type": "string"
    },
    "quest_ref": {
      "type": "string"
    },
    "completion_mode": {
      "type": "string",
      "enum": [
        "reveal_oath",
        "conceal_oath",
        "bind_oath",
        "study_oath",
        "weaponize_oath",
        "restore_relation",
        "contain_anomaly",
        "stabilize_threshold",
        "refuse_resolution",
        "custom"
      ]
    },
    "truth_scope": {
      "type": "string",
      "enum": [
        "base_world_truth",
        "shared_world_truth",
        "leaf_branch_truth",
        "player_perception",
        "mythic_interpretation",
        "prophetic_pressure",
        "faction_claim",
        "host_materialization",
        "diagnostic_noop"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "ash_model_ref": {
          "type": "string"
        },
        "ash_pattern_system_diagnostic_ref": {
          "type": "string"
        },
        "quest_manifest_ref": {
          "type": "string"
        },
        "player_action_trace_ref": {
          "type": "string"
        },
        "branch_event_ref": {
          "type": "string"
        },
        "worldstate_delta_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "npc_relationship_delta_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relationship_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "delta_id",
    "quest_ref",
    "completion_mode",
    "truth_scope",
    "provenance"
  ]
}
