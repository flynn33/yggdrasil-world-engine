{
  "schema_id": "ywe.quest_stage_candidate.v1",
  "schema_version": "0.1.0",
  "status": "draft_for_phase_12_implementation",
  "authority": {
    "game": "Where Ravens Wait: Eternal Reckoning",
    "engine": "Yggdrasil World Engine",
    "foundation": "ASH Cosmological Model",
    "resilience_component": "ASH Pattern System"
  },
  "purpose": "Candidate stage within a generated quest chain.",
  "required_fields": [
    "stage_candidate_id",
    "quest_candidate_ref",
    "stage_kind",
    "stage_pressure",
    "required_context_refs",
    "allowed_player_verbs",
    "expected_state_reads",
    "expected_state_write_classes",
    "truth_scope"
  ],
  "optional_fields": [
    "npc_refs",
    "lore_refs",
    "location_overlay_refs"
  ],
  "forbidden": [
    "stage_without_parent_quest",
    "stage_without_expected_consequence"
  ],
  "validation_notes": [
    "This is a code-agnostic contract schema unless the repository enforces a specific JSON Schema dialect.",
    "Field names may be adapted to existing repository conventions while preserving semantics.",
    "Generated content must be provenance-bearing, truth-scoped, and context-derived."
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/quest_stage_candidate_schema.json",
  "title": "Quest Stage Candidate Schema",
  "x-ywe-requirement-id": "YWE-M2-SCHEMA-DATA-SCHEMAS-QUEST-STAGE-CANDIDATE-SCHEMA-JSON",
  "type": "object",
  "required": [
    "stage_candidate_id",
    "quest_candidate_ref",
    "stage_kind",
    "stage_pressure",
    "required_context_refs",
    "allowed_player_verbs",
    "expected_state_reads",
    "expected_state_write_classes",
    "truth_scope"
  ],
  "properties": {
    "allowed_player_verbs": {
      "type": "string",
      "minLength": 1
    },
    "expected_state_reads": {
      "type": "string",
      "minLength": 1
    },
    "expected_state_write_classes": {
      "type": "string",
      "minLength": 1
    },
    "location_overlay_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "lore_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "npc_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "quest_candidate_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "required_context_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "stage_candidate_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "stage_kind": {
      "type": "string",
      "minLength": 1
    },
    "stage_pressure": {
      "type": "string",
      "minLength": 1
    },
    "truth_scope": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
