{
  "schema_id": "ywe.quest_generation_context.v1",
  "schema_version": "0.1.0",
  "status": "draft_for_phase_12_implementation",
  "authority": {
    "game": "Where Ravens Wait: Eternal Reckoning",
    "engine": "Yggdrasil World Engine",
    "foundation": "ASH Cosmological Model",
    "resilience_component": "ASH Pattern System"
  },
  "purpose": "Context packet used to generate quest candidates from axiom pressure, branch reality, player state, location state, and worldstate consequences.",
  "required_fields": [
    "context_id",
    "branch_reality_ref",
    "player_runtime_state_ref",
    "location_state_ref",
    "worldstate_delta_refs",
    "axiom_diagnostic_refs",
    "existence_potential_ref",
    "pattern_vector_refs",
    "plane_pressure_refs",
    "truth_scope",
    "future_generation_bias_refs",
    "provenance"
  ],
  "optional_fields": [
    "wolf_resonance_ref",
    "bloodline_resonance_ref",
    "attunement_refs",
    "npc_context_refs",
    "lore_context_refs",
    "asp_diagnostic_refs"
  ],
  "forbidden": [
    "generic_random_quest_seed_as_primary_source",
    "quest_without_context",
    "quest_without_truth_scope"
  ],
  "validation_notes": [
    "This is a code-agnostic contract schema unless the repository enforces a specific JSON Schema dialect.",
    "Field names may be adapted to existing repository conventions while preserving semantics.",
    "Generated content must be provenance-bearing, truth-scoped, and context-derived."
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/quest_generation_context_schema.json",
  "title": "Quest Generation Context Schema",
  "x-ywe-requirement-id": "YWE-M2-SCHEMA-DATA-SCHEMAS-QUEST-GENERATION-CONTEXT-SCHEMA-JSON",
  "type": "object",
  "required": [
    "context_id",
    "branch_reality_ref",
    "player_runtime_state_ref",
    "location_state_ref",
    "worldstate_delta_refs",
    "axiom_diagnostic_refs",
    "existence_potential_ref",
    "pattern_vector_refs",
    "plane_pressure_refs",
    "truth_scope",
    "future_generation_bias_refs",
    "provenance"
  ],
  "properties": {
    "asp_diagnostic_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "attunement_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "axiom_diagnostic_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "bloodline_resonance_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "branch_reality_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "context_id": {
