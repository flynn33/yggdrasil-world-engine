{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/state_migration_plan_schema.json",
  "title": "Closed explicit M4 migration plans",
  "x-ywe-requirement-id": "YWE-REQ-0054",
  "type": "object",
  "required": [
    "schema_ref",
    "format",
    "plans"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_ref": {
      "const": "data/schemas/state_migration_plan_schema.json"
    },
    "format": {
      "const": "ywe.state_migration_plans.v1"
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "migration_id",
          "source_document_id",
          "target_document_id",
          "source_schema_id",
          "target_schema_id",
          "source_version",
          "target_version",
          "source_schema_sha256",
          "target_schema_sha256",
          "rules"
        ],
        "properties": {
          "migration_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "source_document_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "target_document_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "source_schema_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "target_schema_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "source_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "target_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "source_schema_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "target_schema_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "parent_path",
                "source_field",
                "target_field"
              ],
              "properties": {
                "parent_path": {
                  "type": "array",
                  "maxItems": 8,
                  "items": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
                        "not": {
                          "pattern": "[\\r\\n]"
                        }
                      },
                      {
                        "const": "*"
                      }
                    ]
                  }
                },
                "source_field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
                  "not": {
                    "pattern": "[\\r\\n]"
                  }
                },
                "target_field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
                  "not": {
                    "pattern": "[\\r\\n]"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
