{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_id": "ywe.engine_cosmology_framework.v1",
  "title": "Engine Cosmology Framework",
  "type": "object",
  "required": [
    "foundation",
    "setting_bible",
    "designer_extensibility",
    "structural_realm_layers"
  ],
  "properties": {
    "foundation": {
      "const": "ASH_Model_of_the_Universe"
    },
    "setting_bible": {
      "const": false
    },
    "designer_extensibility": {
      "const": true
    },
    "structural_realm_layers": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "string"
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "enum": [
          "archetype",
          "symbolic",
          "harmonic"
        ]
      }
    }
  }
}
