{
  "schema_id": "ywe.content_generation_candidate.v1",
  "schema_version": "0.1.0",
  "status": "draft_for_phase_12_implementation",
  "authority": {
    "game": "Where Ravens Wait: Eternal Reckoning",
    "engine": "Yggdrasil World Engine",
    "foundation": "ASH Cosmological Model",
    "resilience_component": "ASH Pattern System"
  },
  "purpose": "Generic candidate wrapper for Phase 12 content before final exchange.",
  "required_fields": [
    "candidate_id",
    "candidate_kind",
    "generation_context_ref",
    "provenance_ref",
    "truth_scope",
    "eligibility_gate_ref",
    "rejection_policy",
    "exchange_target"
  ],
  "optional_fields": [
    "quest_candidate_ref",
    "npc_candidate_ref",
    "lore_fragment_ref",
    "confidence_score",
    "risk_flags"
  ],
  "forbidden": [
    "candidate_without_context",
    "candidate_without_truth_scope"
  ],
  "validation_notes": [
    "This is a code-agnostic contract schema unless the repository enforces a specific JSON Schema dialect.",
    "Field names may be adapted to existing repository conventions while preserving semantics.",
    "Generated content must be provenance-bearing, truth-scoped, and context-derived."
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/content_generation_candidate_schema.json",
  "title": "Content Generation Candidate Schema",
  "x-ywe-requirement-id": "YWE-M2-SCHEMA-DATA-SCHEMAS-CONTENT-GENERATION-CANDIDATE-SCHEMA-JSON",
  "type": "object",
  "required": [
    "candidate_id",
    "candidate_kind",
    "generation_context_ref",
    "provenance_ref",
    "truth_scope",
    "eligibility_gate_ref",
    "rejection_policy",
    "exchange_target"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "candidate_kind": {
      "type": "string",
      "minLength": 1
    },
    "confidence_score": {
      "type": "string",
      "minLength": 1
    },
    "eligibility_gate_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "exchange_target": {
      "type": "string",
      "minLength": 1
    },
    "generation_context_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "lore_fragment_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "npc_candidate_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "provenance_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "quest_candidate_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "rejection_policy": {
      "type": "string",
      "minLength": 1
    },
    "risk_flags": {
      "type": "string",
      "minLength": 1
    },
    "truth_scope": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
