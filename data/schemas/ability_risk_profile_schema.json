{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yggdrasilworldengine.local/schemas/ability_risk_profile_schema.json",
  "title": "AbilityRiskProfile",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_id": {
      "const": "ywe.ability_risk_profile.v1"
    },
    "schema_version": {
      "type": "string"
    },
    "risk_profile_id": {
      "type": "string"
    },
    "ability_id": {
      "type": "string"
    },
    "risk_kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "coherence_pressure",
          "wolf_decoherence",
          "location_instability",
          "branch_instability",
          "artifact_strain",
          "mythic_attention",
          "prophecy_pressure",
          "npc_reaction",
          "worldstate_delta"
        ]
      }
    },
    "risk_mitigation_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Reference object",
        "additionalProperties": true,
        "properties": {
          "ref_id": {
            "type": "string"
          },
          "ref_type": {
            "type": "string"
          },
          "source_system": {
            "type": "string"
          }
        },
        "required": [
          "ref_id"
        ]
      }
    },
    "forbidden_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "risk_profile_id",
    "ability_id",
    "risk_kinds"
  ]
}
