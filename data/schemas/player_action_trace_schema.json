{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ywe.player_action_trace.v1",
  "title": "Player Action Trace",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "action_trace_id",
    "player_id",
    "action_kind",
    "significance",
    "branch_relevance",
    "source_refs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "const": "ywe.player_action_trace.v1"
    },
    "schema_version": {
      "type": "string",
      "default": "0.1.0"
    },
    "action_trace_id": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "action_kind": {
      "type": "string",
      "enum": [
        "choice",
        "quest_resolution",
        "oath_made",
        "oath_broken",
        "truth_revealed",
        "truth_concealed",
        "artifact_bound",
        "bloodline_awakened",
        "wolf_resonance_shift",
        "plane_threshold_crossed",
        "npc_relationship_changed",
        "faction_standing_changed",
        "myth_seeded",
        "prophecy_pressure_changed",
        "location_state_changed",
        "other_meaningful_action"
      ]
    },
    "significance": {
      "type": "string",
      "enum": [
        "minor_record",
        "meaningful",
        "branch_forming",
        "mythic",
        "prophetic"
      ]
    },
    "branch_relevance": {
      "type": "string",
      "enum": [
        "none",
        "contextual",
        "branch_event_candidate",
        "branch_event_created"
      ]
    },
    "location_ref": {
      "type": "string"
    },
    "branch_ref": {
      "type": "string"
    },
    "branch_event_ref": {
      "type": "string"
    },
    "affected_entity_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "resulting_worldstate_delta_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "resulting_player_state_update_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  }
}
