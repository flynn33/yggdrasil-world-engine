{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/worldstate_location_mutation_schema.json",
  "schema_id": "ywe.schemas.worldstate_location_mutation",
  "title": "Worldstate and Location Mutation v1",
  "version": "1.0.0",
  "phase_8_9_boundary_marker": "DEFERRED - Phase 9 boundary violation; do not consume until the matching owner-approved package is accepted.",
  "purpose": "Canonical Phase 11 contract for persistent worldstate consequence and scoped location mutation downstream of Player Runtime State and Leaf Branch Reality.",
  "oneOf": [
    {
      "$ref": "#/$defs/WorldstateDeltaPacket"
    },
    {
      "$ref": "#/$defs/LocationMutationState"
    },
    {
      "$ref": "#/$defs/LocationMutationDelta"
    },
    {
      "$ref": "#/$defs/WorldstateMutationCommit"
    },
    {
      "$ref": "#/$defs/DiagnosticNoOp"
    }
  ],
  "$defs": {
    "WorldstateDeltaPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "version",
        "delta_id",
        "sequence_id",
        "source_resolution_payload",
        "source_branch_event_ref",
        "player_runtime_state_ref",
        "current_leaf_branch_ref",
        "affected_location_refs",
        "location_mutation_refs",
        "consequence_domains",
        "mutations",
        "persistence",
        "reversibility",
        "authority_boundary",
        "ash_provenance",
        "future_generation_bias_update_refs"
      ],
      "properties": {
        "record_type": {
          "const": "WorldstateDeltaPacket"
        },
        "version": {
          "type": "string",
          "const": "1.0.0"
        },
        "delta_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence_id": {
          "type": "integer",
          "minimum": 0
        },
        "source_resolution_payload": {
          "type": "string",
          "minLength": 1
        },
        "source_branch_event_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "player_runtime_state_ref": {
          "type": "string",
          "minLength": 1
        },
        "current_leaf_branch_ref": {
          "type": "string",
          "minLength": 1
        },
        "affected_location_refs": {
          "$ref": "#/$defs/NonEmptyStringRefList"
        },
        "location_mutation_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "consequence_domains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ConsequenceDomain"
          }
        },
        "mutations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/MutationOperation"
          }
        },
        "persistence": {
          "$ref": "#/$defs/PersistenceEnvelope"
        },
        "reversibility": {
          "$ref": "#/$defs/ReversibilityEnvelope"
        },
        "authority_boundary": {
          "$ref": "#/$defs/AuthorityBoundary"
        },
        "ash_provenance": {
          "$ref": "#/$defs/AshProvenance"
        },
        "future_generation_bias_update_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "diagnostic_noop_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "LocationMutationState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "version",
        "location_state_id",
        "location_ref",
        "base_world_ref",
        "current_leaf_branch_ref",
        "active_plane_pressure_ref",
        "status",
        "active_mutation_refs",
        "worldstate_delta_refs",
        "overlays_locked_to_worldstate",
        "authority_boundary",
        "ash_provenance"
      ],
      "properties": {
        "record_type": {
          "const": "LocationMutationState"
        },
        "version": {
          "type": "string",
          "const": "1.0.0"
        },
        "location_state_id": {
          "type": "string",
          "minLength": 1
        },
        "location_ref": {
          "type": "string",
          "minLength": 1
        },
        "base_world_ref": {
          "type": "string",
          "minLength": 1
        },
        "current_leaf_branch_ref": {
          "type": "string",
          "minLength": 1
        },
        "active_plane_pressure_ref": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/LocationMutationStatus"
        },
        "active_mutation_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "worldstate_delta_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "location_overlay_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "threshold_status_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "overlays_locked_to_worldstate": {
          "const": true
        },
        "authority_boundary": {
          "$ref": "#/$defs/AuthorityBoundary"
        },
        "ash_provenance": {
          "$ref": "#/$defs/AshProvenance"
        }
      }
    },
    "LocationMutationDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "version",
        "mutation_delta_id",
        "target_location_state_ref",
        "source_worldstate_delta_ref",
        "source_branch_event_ref",
        "source_player_runtime_state_ref",
        "mutation_kind",
        "changed_fields",
        "persistence_scope",
        "diagnostic_ref",
        "generation_plan_ref",
        "source_ash_refs",
        "authority_boundary"
      ],
      "properties": {
        "record_type": {
          "const": "LocationMutationDelta"
        },
        "version": {
          "type": "string",
          "const": "1.0.0"
        },
        "mutation_delta_id": {
          "type": "string",
          "minLength": 1
        },
        "target_location_state_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_worldstate_delta_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_branch_event_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_player_runtime_state_ref": {
          "type": "string",
          "minLength": 1
        },
        "mutation_kind": {
          "$ref": "#/$defs/LocationMutationKind"
        },
        "changed_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ChangedField"
          }
        },
        "persistence_scope": {
          "$ref": "#/$defs/PersistenceScope"
        },
        "diagnostic_ref": {
          "type": "string",
          "minLength": 1
        },
        "generation_plan_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_ash_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "authority_boundary": {
          "$ref": "#/$defs/AuthorityBoundary"
        }
      }
    },
    "WorldstateMutationCommit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "version",
        "commit_id",
        "source_worldstate_delta_ref",
        "committed_record_refs",
        "commit_scope",
        "contradiction_policy",
        "authority_boundary",
        "ash_provenance"
      ],
      "properties": {
        "record_type": {
          "const": "WorldstateMutationCommit"
        },
        "version": {
          "type": "string",
          "const": "1.0.0"
        },
        "commit_id": {
          "type": "string",
          "minLength": 1
        },
        "source_worldstate_delta_ref": {
          "type": "string",
          "minLength": 1
        },
        "committed_record_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "commit_scope": {
          "$ref": "#/$defs/PersistenceScope"
        },
        "contradiction_policy": {
          "type": "string",
          "enum": [
            "reject_lower_layer_rewrite",
            "preserve_layered_contradiction",
            "require_owner_review",
            "diagnostic_noop"
          ]
        },
        "authority_boundary": {
          "$ref": "#/$defs/AuthorityBoundary"
        },
        "ash_provenance": {
          "$ref": "#/$defs/AshProvenance"
        }
      }
    },
    "DiagnosticNoOp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "version",
        "no_op_id",
        "reason",
        "rejected_mutation_kind",
        "diagnostic_ref",
        "cosmic_pattern_snapshot_ref",
        "generation_plan_ref",
        "source_ash_refs"
      ],
      "properties": {
        "record_type": {
          "const": "DiagnosticNoOp"
        },
        "version": {
          "type": "string",
          "const": "1.0.0"
        },
        "no_op_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "rejected_mutation_kind": {
          "type": "string",
          "enum": [
            "missing_provenance",
            "insufficient_branch_evidence",
            "perception_only_overlay",
            "host_adapter_attempted_write",
            "base_ontology_rewrite",
            "ash_math_mutation",
            "unscoped_location_change"
          ]
        },
        "diagnostic_ref": {
          "type": "string",
          "minLength": 1
        },
        "cosmic_pattern_snapshot_ref": {
          "type": "string",
          "minLength": 1
        },
        "generation_plan_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_ash_refs": {
          "$ref": "#/$defs/StringRefList"
        }
      }
    },
    "MutationOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "domain",
        "operation",
        "target_ref",
        "evidence_refs"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "$ref": "#/$defs/ConsequenceDomain"
        },
        "operation": {
          "type": "string",
          "enum": [
            "append_ref",
            "set_status",
            "adjust_pressure",
            "activate_site",
            "suppress_site",
            "record_residue",
            "commit_public_fact",
            "commit_player_local_fact"
          ]
        },
        "target_ref": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "$ref": "#/$defs/StringRefList"
        }
      }
    },
    "ChangedField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_path",
        "change_kind",
        "reason"
      ],
      "properties": {
        "field_path": {
          "type": "string",
          "minLength": 1
        },
        "change_kind": {
          "type": "string",
          "enum": [
            "append_ref",
            "set_status",
            "set_threshold_status",
            "adjust_plane_pressure",
            "lock_overlay_to_worldstate",
            "record_residue"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "PersistenceEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "visibility",
        "retention_policy",
        "append_only"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/PersistenceScope"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "player_local",
            "branch_local",
            "shared_world",
            "realm_local"
          ]
        },
        "retention_policy": {
          "type": "string",
          "enum": [
            "persistent",
            "until_resolved",
            "timeboxed",
            "diagnostic_noop"
          ]
        },
        "append_only": {
          "const": true
        }
      }
    },
    "ReversibilityEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reversible",
        "requires_new_delta"
      ],
      "properties": {
        "reversible": {
          "type": "boolean"
        },
        "requires_new_delta": {
          "const": true
        },
        "reversal_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "AshProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cosmic_pattern_snapshot_ref",
        "diagnostic_ref",
        "generation_plan_ref",
        "source_ash_refs",
        "axiom_diagnostic_refs",
        "pattern_vector_refs",
        "existence_potential_ref"
      ],
      "properties": {
        "cosmic_pattern_snapshot_ref": {
          "type": "string",
          "minLength": 1
        },
        "diagnostic_ref": {
          "type": "string",
          "minLength": 1
        },
        "generation_plan_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_ash_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "axiom_diagnostic_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "pattern_vector_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "existence_potential_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "AuthorityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "can_influence_generation_context",
        "may_mutate_ash_math",
        "may_rewrite_shared_world_truth",
        "may_mutate_base_world_ontology",
        "host_adapter_may_author"
      ],
      "properties": {
        "can_influence_generation_context": {
          "const": true
        },
        "may_mutate_ash_math": {
          "const": false
        },
        "may_rewrite_shared_world_truth": {
          "const": false
        },
        "may_mutate_base_world_ontology": {
          "const": false
        },
        "host_adapter_may_author": {
          "const": false
        }
      }
    },
    "ConsequenceDomain": {
      "type": "string",
      "enum": [
        "player_memory",
        "player_identity",
        "wolf_resonance",
        "realm_attunement",
        "bloodline_resonance",
        "npc_availability",
        "faction_standing",
        "local_world_condition",
        "location_state",
        "myth_seed_state",
        "prophecy_weight_state",
        "perception_layer",
        "site_activation",
        "temporary_space_residue",
        "recurring_symbol_recurrence",
        "future_generation_bias"
      ]
    },
    "LocationMutationStatus": {
      "type": "string",
      "enum": [
        "base",
        "observed",
        "altered",
        "activated",
        "suppressed",
        "threatened",
        "consecrated",
        "unstable",
        "contained",
        "archived"
      ]
    },
    "LocationMutationKind": {
      "type": "string",
      "enum": [
        "site_activation",
        "site_suppression",
        "threshold_status_change",
        "plane_pressure_shift",
        "residue_recorded",
        "realm_bleed_contained",
        "public_condition_changed",
        "branch_local_condition_changed"
      ]
    },
    "PersistenceScope": {
      "type": "string",
      "enum": [
        "player_local",
        "leaf_branch",
        "shared_world",
        "realm_local"
      ]
    },
    "StringRefList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "NonEmptyStringRefList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "forbidden_interpretations": [
    "worldstate_delta_mutates_ash_math",
    "location_mutation_rewrites_base_world_ontology",
    "perception_overlay_as_location_mutation",
    "host_adapter_authored_worldstate",
    "worldstate_delta_without_source_resolution_or_diagnostic"
  ]
}
