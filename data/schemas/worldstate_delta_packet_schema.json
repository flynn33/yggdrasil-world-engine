{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_id": "ywe.schemas.worldstate_delta_packet",
  "version": "1.0.0",
  "status": "phase_11_extended",
  "purpose": "Persistent consequence packet for meaningful YWE resolutions.",
  "phase_11_schema_ref": "worldstate_location_mutation_schema.json",
  "required_records": {
    "WorldstateDeltaPacket": {
      "required": [
        "delta_id",
        "source_resolution_payload",
        "source_branch_event_ref",
        "player_runtime_state_ref",
        "current_leaf_branch_ref",
        "affected_location_refs",
        "location_mutation_refs",
        "cosmic_pattern_snapshot_ref",
        "diagnostic_ref",
        "generation_plan_ref",
        "source_ash_refs",
        "scope",
        "persistence",
        "reversibility",
        "future_generation_bias_update"
      ],
      "properties": {
        "source_ash_refs": "SourceASHRefs",
        "diagnostic_ref": "DiagnosticEnvelope",
        "generation_plan_ref": "GenerationPlan",
        "player_runtime_state_ref": "PlayerRuntimeState",
        "current_leaf_branch_ref": "LeafBranchReality",
        "location_mutation_refs": "LocationMutationDelta",
        "future_generation_bias_update": "FutureGenerationBiasUpdate"
      }
    },
    "LocationMutationState": {
      "required": [
        "location_state_id",
        "location_ref",
        "base_world_ref",
        "current_leaf_branch_ref",
        "status",
        "active_mutation_refs",
        "worldstate_delta_refs",
        "authority_boundary",
        "ash_provenance"
      ],
      "rule": "LocationMutationState changes only through accepted WorldstateDeltaPacket evidence or explicit DiagnosticNoOp."
    },
    "LocationMutationDelta": {
      "required": [
        "mutation_delta_id",
        "target_location_state_ref",
        "source_worldstate_delta_ref",
        "source_player_runtime_state_ref",
        "mutation_kind",
        "diagnostic_ref",
        "generation_plan_ref",
        "source_ash_refs"
      ],
      "rule": "LocationMutationDelta must be scoped and cannot rewrite base ontology."
    },
    "WorldstateMutationCommit": {
      "required": [
        "commit_id",
        "source_worldstate_delta_ref",
        "committed_record_refs",
        "commit_scope",
        "contradiction_policy"
      ]
    },
    "FutureGenerationBiasUpdate": {
      "required": [
        "bias_id",
        "affected_domains",
        "pressure_tags",
        "source_delta_ref",
        "diagnostic_ref"
      ]
    },
    "DiagnosticNoOp": {
      "required": [
        "no_op_id",
        "reason",
        "diagnostic_ref",
        "cosmic_pattern_snapshot_ref",
        "generation_plan_ref"
      ],
      "rule": "Every meaningful completion emits WorldstateDeltaPacket or explicit DiagnosticNoOp."
    }
  },
  "invariants": [
    "worldstate_changes_require_source_ash_refs",
    "meaningful_resolutions_cannot_reset_consequences_without_delta",
    "untraceable_state_changes_are_forbidden",
    "location_mutation_refs_must_be_scoped",
    "perception_overlay_cannot_author_location_mutation",
    "host_adapter_may_not_author_worldstate",
    "worldstate_delta_must_not_mutate_ash_math",
    "location_mutation_must_not_mutate_base_world_ontology"
  ]
}
