{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/ywe.worldstate_delta_packet.v1.json",
  "title": "Worldstate Delta Packet",
  "description": "Records meaningful consequences to world, branch, location, perception, myth, prophecy, faction, and future generation state.",
  "type": "object",
  "required": [
    "schema_id",
    "version",
    "delta_id",
    "truth_scope",
    "consequence_classes",
    "source_context",
    "delta_body",
    "provenance",
    "validation"
  ],
  "properties": {
    "schema_id": {
      "const": "ywe.worldstate_delta_packet.v1"
    },
    "version": {
      "type": "string"
    },
    "delta_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp_policy": {
      "type": "string",
      "enum": [
        "logical_tick",
        "branch_event_time",
        "host_runtime_time_optional"
      ]
    },
    "truth_scope": {
      "type": "string",
      "enum": [
        "base_world_truth",
        "shared_world_truth",
        "leaf_branch_truth",
        "player_perception",
        "mythic_interpretation",
        "prophetic_pressure",
        "faction_claim",
        "host_materialization",
        "diagnostic_noop"
      ]
    },
    "consequence_classes": {
      "type": "array",
      "items": {
        "enum": [
          "shared_world_truth_change",
          "leaf_branch_truth_change",
          "location_state_change",
          "location_access_change",
          "perception_overlay_change",
          "myth_pressure_change",
          "prophecy_pressure_change",
          "faction_claim_change",
          "npc_relationship_change",
          "artifact_binding_change",
          "creature_ecology_change",
          "ability_pressure_change",
          "player_state_reference",
          "future_generation_bias_update",
          "diagnostic_noop"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "source_context": {
      "type": "object",
      "properties": {
        "player_id": {
          "type": "string"
        },
        "branch_id": {
          "type": "string"
        },
        "location_id": {
          "type": "string"
        },
        "branch_event_ref": {
          "type": "string"
        },
        "player_action_trace_ref": {
          "type": "string"
        },
        "player_state_snapshot_ref": {
          "type": "string"
        },
        "location_resolution_context_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "delta_body": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "before_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "after_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_cosmology_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ash_pattern_diagnostic_ref": {
          "type": "string"
        },
        "ash_pattern_recovery_ref": {
          "type": "string"
        },
        "generation_plan_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "properties": {
        "location_state_record_ref": {
          "type": "string"
        },
        "location_branch_overlay_ref": {
          "type": "string"
        },
        "future_generation_bias_update_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "player_state_update_packet_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": [
        "requires_delta_or_noop",
        "passes_truth_scope_guardrail"
      ],
      "properties": {
        "requires_delta_or_noop": {
          "const": true
        },
        "passes_truth_scope_guardrail": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
