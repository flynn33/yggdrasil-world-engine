{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/public_promise_register_schema.json",
  "title": "YWE Public Promise Register",
  "type": "object",
  "required": [
    "artifact_type",
    "artifact_version",
    "schema_ref",
    "repository_baseline",
    "roadmap_ref",
    "publication_state",
    "reviewed_surfaces",
    "reviewed_surface_aggregate_sha256",
    "promises",
    "summary"
  ],
  "properties": {
    "artifact_type": {
      "const": "ywe_public_promise_register"
    },
    "artifact_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "schema_ref": {
      "const": "data/schemas/public_promise_register_schema.json"
    },
    "repository_baseline": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "roadmap_ref": {
      "const": "data/governance/specification_roadmap.json"
    },
    "publication_state": {
      "enum": [
        "unreleased",
        "released"
      ]
    },
    "reviewed_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reviewed_surface"
      }
    },
    "reviewed_surface_aggregate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "promises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/promise"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    }
  },
  "$defs": {
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
    },
    "reviewed_surface": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repository_path"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "source_ref": {
      "type": "object",
      "required": [
        "path",
        "locator_type",
        "locator"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repository_path"
        },
        "locator_type": {
          "enum": [
            "exact_text",
            "json_pointer",
            "line_range",
            "markdown_heading"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "locator_type": {
                "const": "line_range"
              }
            },
            "required": [
              "locator_type"
            ]
          },
          "then": {
            "required": [
              "line_start",
              "line_end"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "line_start"
                  ]
                },
                {
                  "required": [
                    "line_end"
                  ]
                }
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "promise": {
      "type": "object",
      "required": [
        "promise_id",
        "claim",
        "claim_type",
        "status",
        "disposition",
        "milestones",
        "owner_role",
        "interpretation_constraint",
        "source_refs"
      ],
      "properties": {
        "promise_id": {
          "type": "string",
          "pattern": "^PRM-[0-9]{3}$"
        },
        "claim": {
          "type": "string",
          "minLength": 5
        },
        "claim_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "status": {
          "const": "active"
        },
        "disposition": {
          "enum": [
            "milestone_assigned",
            "formally_excluded"
          ]
        },
        "milestones": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^M(?:[0-9]|10)$"
          }
        },
        "owner_role": {
          "type": "string",
          "minLength": 3
        },
        "interpretation_constraint": {
          "type": "string",
          "minLength": 10
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        },
        "exclusion_reason": {
          "type": "string",
          "minLength": 10
        },
        "exclusion_authority_ref": {
          "$ref": "#/$defs/repository_path"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "milestone_assigned"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "milestones": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "formally_excluded"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "required": [
              "exclusion_reason",
              "exclusion_authority_ref"
            ],
            "properties": {
              "milestones": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "reviewed_surface_count",
        "promise_count",
        "assigned_count",
        "excluded_count",
        "unresolved_count"
      ],
      "properties": {
        "reviewed_surface_count": {
          "type": "integer",
          "minimum": 1
        },
        "promise_count": {
          "type": "integer",
          "minimum": 1
        },
        "assigned_count": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_count": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_count": {
          "const": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
