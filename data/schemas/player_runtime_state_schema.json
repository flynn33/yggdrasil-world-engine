{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/player_runtime_state_schema.json",
  "schema_id": "ywe.schemas.player_runtime_state",
  "title": "Player Runtime State v1",
  "version": "1.0.0",
  "phase_8_9_boundary_marker": "DEFERRED - Phase 9 boundary violation; do not consume until the matching owner-approved package is accepted.",
  "purpose": "Canonical runtime state contract for player-specific YWE truth, phase, memory, branch reality context, attunement, and generation context references.",
  "oneOf": [
    {
      "$ref": "#/$defs/PlayerRuntimeState"
    },
    {
      "$ref": "#/$defs/PlayerRuntimeStateDelta"
    }
  ],
  "$defs": {
    "PlayerRuntimeState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "version",
        "state_id",
        "player_ref",
        "sequence_id",
        "current_phase",
        "phase_confidence",
        "identity_reveal_policy",
        "origin",
        "celestial_memory",
        "realm_attunement",
        "wolf_resonance",
        "bloodline_resonance",
        "current_leaf_branch_ref",
        "branch_generation_context_refs",
        "branch_event_refs",
        "awakening_fragments",
        "narrative_memory_refs",
        "unresolved_tension_refs",
        "active_worldstate_delta_refs",
        "future_generation_bias_refs",
        "perception_state_ref",
        "authority_boundary",
        "ash_provenance",
        "update_policy"
      ],
      "properties": {
        "record_type": {
          "const": "PlayerRuntimeState"
        },
        "version": {
          "type": "string",
          "const": "1.0.0"
        },
        "state_id": {
          "type": "string",
          "minLength": 1
        },
        "player_ref": {
          "type": "string",
          "minLength": 1
        },
        "sequence_id": {
          "type": "integer",
          "minimum": 0
        },
        "current_phase": {
          "$ref": "#/$defs/PlayerOriginPhase"
        },
        "phase_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "identity_reveal_policy": {
          "type": "string",
          "enum": [
            "reveal_through_play",
            "withhold_until_supported_by_evidence"
          ]
        },
        "origin": {
          "type": "string",
          "const": "mortal"
        },
        "celestial_memory": {
          "type": "string",
          "enum": [
            "veiled",
            "fractured",
            "partial_recall",
            "integrated_recall"
          ]
        },
        "realm_attunement": {
          "$ref": "#/$defs/RealmAttunement"
        },
        "active_realm_form": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "divine_core",
            "celestial",
            "causal",
            "mental",
            "astral",
            "etheric",
            "physical",
            "shadow",
            "void",
            null
          ]
        },
        "wolf_resonance": {
          "$ref": "#/$defs/WolfResonance"
        },
        "bloodline_resonance": {
          "$ref": "#/$defs/NamedResonanceMap"
        },
        "current_leaf_branch_ref": {
          "type": "string",
          "minLength": 1
        },
        "branch_generation_context_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "branch_event_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "awakening_fragments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AwakeningFragment"
          }
        },
        "narrative_memory_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "relationship_state_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "faction_stance_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "unresolved_tension_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "active_quest_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "completed_resolution_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "active_worldstate_delta_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "future_generation_bias_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "perception_state_ref": {
          "type": "string",
          "minLength": 1
        },
        "last_player_action_trace_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "generation_context_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "authority_boundary": {
          "$ref": "#/$defs/AuthorityBoundary"
        },
        "ash_provenance": {
          "$ref": "#/$defs/AshProvenance"
        },
        "update_policy": {
          "$ref": "#/$defs/UpdatePolicy"
        },
        "audit": {
          "$ref": "#/$defs/AuditEnvelope"
        }
      }
    },
    "PlayerRuntimeStateDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "version",
        "delta_id",
        "target_state_ref",
        "sequence_from",
        "sequence_to",
        "trigger_trace_ref",
        "branch_event_ref",
        "changed_fields",
        "disposition",
        "diagnostic_ref",
        "generation_plan_ref",
        "source_ash_refs"
      ],
      "properties": {
        "record_type": {
          "const": "PlayerRuntimeStateDelta"
        },
        "version": {
          "type": "string",
          "const": "1.0.0"
        },
        "delta_id": {
          "type": "string",
          "minLength": 1
        },
        "target_state_ref": {
          "type": "string",
          "minLength": 1
        },
        "sequence_from": {
          "type": "integer",
          "minimum": 0
        },
        "sequence_to": {
          "type": "integer",
          "minimum": 0
        },
        "trigger_trace_ref": {
          "type": "string",
          "minLength": 1
        },
        "branch_event_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch_generation_context_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "affected_leaf_branch_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "source_worldstate_delta_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "changed_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ChangedField"
          }
        },
        "disposition": {
          "type": "string",
          "enum": [
            "accepted",
            "rejected_diagnostic_noop",
            "deferred_pending_authority",
            "merged_with_existing_delta"
          ]
        },
        "diagnostic_ref": {
          "type": "string",
          "minLength": 1
        },
        "generation_plan_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_ash_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "rejection_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "audit": {
          "$ref": "#/$defs/AuditEnvelope"
        }
      }
    },
    "PlayerOriginPhase": {
      "type": "string",
      "enum": [
        "mortal_unknowing",
        "first_stirrings",
        "memory_recovery",
        "identity_conflict",
        "chosen_becoming",
        "world_actor"
      ]
    },
    "RealmAttunement": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "WolfResonance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "white_wolf",
        "dark_wolf",
        "interpretation"
      ],
      "properties": {
        "white_wolf": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dark_wolf": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "interpretation": {
          "const": "symbiotic_attractors_not_morality_meter"
        }
      }
    },
    "NamedResonanceMap": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "AwakeningFragment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fragment_id",
        "evidence_refs",
        "confidence"
      ],
      "properties": {
        "fragment_id": {
          "type": "string"
        },
        "evidence_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "AuthorityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "can_influence_generation_context",
        "may_mutate_ash_math",
        "may_rewrite_shared_world_truth",
        "may_mutate_base_world_ontology",
        "host_adapter_may_author"
      ],
      "properties": {
        "can_influence_generation_context": {
          "const": true
        },
        "may_mutate_ash_math": {
          "const": false
        },
        "may_rewrite_shared_world_truth": {
          "const": false
        },
        "may_mutate_base_world_ontology": {
          "const": false
        },
        "host_adapter_may_author": {
          "const": false
        }
      }
    },
    "AshProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cosmic_pattern_snapshot_ref",
        "diagnostic_ref",
        "generation_plan_ref",
        "source_ash_refs",
        "axiom_diagnostic_refs",
        "pattern_vector_refs",
        "existence_potential_ref"
      ],
      "properties": {
        "cosmic_pattern_snapshot_ref": {
          "type": "string"
        },
        "diagnostic_ref": {
          "type": "string"
        },
        "generation_plan_ref": {
          "type": "string"
        },
        "source_ash_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "axiom_diagnostic_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "pattern_vector_refs": {
          "$ref": "#/$defs/StringRefList"
        },
        "existence_potential_ref": {
          "type": "string"
        }
      }
    },
    "UpdatePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires_delta",
        "append_first_memory",
        "diagnostic_noop_allowed",
        "branch_event_required_for_branch_mutation"
      ],
      "properties": {
        "requires_delta": {
          "const": true
        },
        "append_first_memory": {
          "const": true
        },
        "diagnostic_noop_allowed": {
          "const": true
        },
        "branch_event_required_for_branch_mutation": {
          "const": true
        }
      }
    },
    "ChangedField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_path",
        "change_kind",
        "reason"
      ],
      "properties": {
        "field_path": {
          "type": "string"
        },
        "change_kind": {
          "type": "string",
          "enum": [
            "append_ref",
            "set_phase",
            "adjust_resonance",
            "set_branch_ref",
            "record_diagnostic_noop"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "AuditEnvelope": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "created_by": {
          "type": "string"
        },
        "created_at_ref": {
          "type": "string"
        },
        "validation_refs": {
          "$ref": "#/$defs/StringRefList"
        }
      }
    },
    "StringRefList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
