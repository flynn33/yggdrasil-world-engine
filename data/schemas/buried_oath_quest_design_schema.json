{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x_ywe_phase": "16",
  "x_status": "phase_16_recovery",
  "title": "Buried Oath Quest Design",
  "description": "Buried Oath Quest Design",
  "type": "object",
  "required": [
    "schema_id",
    "phase_id",
    "slice_id",
    "quest_id",
    "completion_modes"
  ],
  "properties": {
    "schema_id": {
      "type": "string"
    },
    "phase_id": {
      "const": "phase_16"
    },
    "slice_id": {
      "const": "ravenfall_gate"
    },
    "status": {
      "type": "string"
    },
    "source_truth_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires_phase_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quest_id": {
      "const": "the_buried_oath_at_ravenfall_gate"
    },
    "completion_modes": {
      "type": "array",
      "items": {
        "enum": [
          "reveal",
          "conceal",
          "bind",
          "study",
          "weaponize"
        ]
      }
    },
    "quest_stages": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
