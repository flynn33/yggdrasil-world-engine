{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/common/diagnostic.schema.json",
  "description": "YWE M2 common diagnostic contract.",
  "x-ywe-requirement-id": "YWE-M2-COMMON-DIAGNOSTIC",
  "title": "Diagnostic",
  "type": "object",
  "required": [
    "diagnostic_id",
    "severity",
    "message"
  ],
  "properties": {
    "diagnostic_id": {
      "$ref": "https://ywe.local/schemas/common/identifier.schema.json"
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "error",
        "fatal"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
