{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/common/provenance.schema.json",
  "description": "YWE M2 common provenance contract.",
  "x-ywe-requirement-id": "YWE-M2-COMMON-PROVENANCE",
  "title": "Provenance",
  "type": "object",
  "required": [
    "source_refs"
  ],
  "properties": {
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://ywe.local/schemas/common/reference.schema.json"
      }
    },
    "derived_at": {
      "$ref": "https://ywe.local/schemas/common/time.schema.json"
    }
  },
  "additionalProperties": false
}
