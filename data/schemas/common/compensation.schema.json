{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/common/compensation.schema.json",
  "description": "YWE M2 common compensation contract.",
  "x-ywe-requirement-id": "YWE-M2-COMMON-COMPENSATION",
  "title": "Compensation",
  "type": "object",
  "required": [
    "compensation_id",
    "target_transaction_ref",
    "action"
  ],
  "properties": {
    "compensation_id": {
      "$ref": "https://ywe.local/schemas/common/identifier.schema.json"
    },
    "target_transaction_ref": {
      "$ref": "https://ywe.local/schemas/common/reference.schema.json"
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "planned",
        "applied",
        "failed"
      ]
    }
  },
  "additionalProperties": false
}
