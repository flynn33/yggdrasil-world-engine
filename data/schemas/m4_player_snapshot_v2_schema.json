          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "consumed_request_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "consumed_effects": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/consumed_effect"
          }
        },
        "consumed_manifestation_event_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "consumed_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "update_ref",
        "consequence_ref",
