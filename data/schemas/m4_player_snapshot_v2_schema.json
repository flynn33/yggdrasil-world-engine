      ],
      "properties": {
        "update_ref": {
          "$ref": "#/$defs/identifier"
        },
        "consequence_ref": {
          "$ref": "#/$defs/identifier"
        },
        "effect": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
