{
  "budget_id": "ywe.phase_12.non_destructive_change_budget",
  "allowed": {
    "new_markdown_files": "expected",
    "new_json_files": "expected",
    "surgical_index_updates": "allowed",
    "existing_schema_extension": "allowed_if_compatibility_preserved"
  },
  "limits": {
    "max_existing_files_touched_without_review": 25,
    "max_existing_file_deletions": 0,
    "max_directory_renames": 0,
    "max_copied_paths": 0
  },
  "forbidden": {
    "file_deletions": "forbidden",
    "directory_flattening": "forbidden",
    "mass_rewrites": "forbidden",
    "platform_specific_code": "forbidden",
    "blind_find_replace": "forbidden"
  },
  "stop_if": [
    "existing accepted artifact deletion required",
    "schema conflict cannot be resolved conservatively",
    "repository checks fail before implementation"
  ]
}
