  "adapter_paths": [
    "adapters/unity/adapter_interface.md",
    "adapters/unity/entity_spawn_bridge.md",
    "adapters/unity/environment_bridge.md",
    "adapters/unreal/adapter_interface.md",
    "adapters/unreal/entity_spawn_bridge.md",
    "adapters/unreal/environment_bridge.md",
    "adapters/godot/adapter_interface.md",
    "adapters/godot/entity_spawn_bridge.md",
    "adapters/godot/environment_bridge.md"
  ],
  "architecture_extension_package": "YWE_ASH_UPSTREAM_AUTHORITY_PACKAGE",
  "authority_contract": "docs/architecture/ash_upstream_authority_contract.md",
  "upstream_authority_gate_contract": "data/validation/ash_upstream_authority_gate_contract.json",
  "required_packet_spine": [
    "RuntimeGenerationTrigger",
    "YWEGenerationContextPacket",
    "ASHUpstreamGenerationEnvelope",
    "YWEInterpretationPacket",
    "SystemManifestExchange",
    "HostAdapterMaterializationRequest",
    "MaterializationResult",
    "ResolutionPayload",
    "WorldstateDeltaPacket|DiagnosticNoOp",
    "FutureGenerationBiasUpdate"
  ],
  "required_provenance_fields": [
    "source_ash_refs",
    "diagnostic_ref",
    "generation_plan_ref",
    "requested_manifest_kind",
    "worldstate_delta_policy"
  ],
  "meaningful_manifest_targets": [
    "WorldRegionManifest",
    "RealmSiteManifest",
    "ThresholdManifest",
    "QuestChainManifest",
    "NPCManifest",
    "CreatureManifest",
    "ArtifactManifest",
    "MythRecord",
    "ProphecyRecord",
    "PerceptionStateRecord",
    "FactionDelta",
    "ProgressionDelta"
  ],
  "reject_if": [
    "local_symbolic_rng_as_source_of_meaning",
    "ywe_defined_ash_state_space",
    "ywe_defined_codeword_set",
    "derived_ninth_bit",
    "eight_plus_one_state_model",
    "materialization_before_generation_plan",
    "adapter_authored_truth",
    "feature_engine_claims_math_authority",
    "player_action_mutates_ash_math"
  ]
}
