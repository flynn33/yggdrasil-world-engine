        "NPCManifest",
        "RelationshipVector",
        "TruthFunction",
        "PersistenceState",
        "FactionTopologyState"
      ]
    },
    {
      "system": "worldstate_delta_engine",
      "paths": [
        "core/narrative_engine/engine_interface.json",
        "core/narrative_engine/worldstate_delta_rules.yaml",
