        "EncounterPlan",
        "BehaviorPressureVector",
        "source_ash_refs"
      ]
    },
    {
      "system": "artifact_engine",
      "paths": [
        "modules/artifact_engine/artifact_engine_interface.json",
        "data/schemas/artifact_manifest_schema.json"
      ],
      "required_markers": [
        "ArtifactManifest",
        "UseConsequenceRoute",
        "MythSeedCandidate",
        "ArtifactDescription"
      ]
    },
    {
      "system": "npc_synthesis",
      "paths": [
