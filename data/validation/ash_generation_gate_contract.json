      ],
      "required_markers": [
        "LoreArchiveRecord",
        "LoreRecordVariant",
        "VisibilityScope",
        "locked_canon"
      ]
    },
    {
      "system": "realm_mechanics_and_transitions",
      "paths": [
        "core/realm_engine/engine_interface.json",
        "data/schemas/realm_transition_resolution_schema.json",
        "data/realm/realm_mechanics_rules.yaml",
        "data/realm/realm_boundary_profiles.yaml"
      ],
      "required_markers": [
        "RealmTransitionResolution",
        "WorldstateDeltaPacket",
        "RealmBoundaryProfileRecord",
        "CosmicPatternSnapshot"
      ]
    }
