{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_id": "ywe.validation.ash_generation_gate_contract",
  "version": "1.0.0",
  "active_package": "YWE_ASP_CORE_MATH_REBUILD_PACKAGE",
  "governance": {
    "mcp_record": "conformance/governance-boot-record.md",
    "subagent_record": "conformance/governance-boot-record.md",
    "acceptance_record": "conformance/acceptance-judgment.md",
    "deviation_record": "conformance/deviation-log.md"
  },
  "shared_required_markers": [
    "CosmicPatternSnapshot",
    "DiagnosticEnvelope",
