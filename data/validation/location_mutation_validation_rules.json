{
  "id": "ywe.phase_11.location_mutation_validation_rules",
  "version": "1.0.0",
  "rules": [
    "location_mutation_requires_location_id",
    "location_mutation_requires_trigger",
    "location_mutation_requires_truth_scope",
    "location_mutation_requires_provenance",
    "location_mutation_must_not_redefine_base_ontology",
    "location_mutation_must_emit_delta_or_noop",
    "location_mutation_may_emit_future_generation_bias"
  ]
}
