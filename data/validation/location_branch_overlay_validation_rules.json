{
  "id": "ywe.phase_11.location_branch_overlay_validation_rules",
  "version": "1.0.0",
  "rules": [
    "overlay_requires_branch_id",
    "overlay_requires_location_id",
    "overlay_truth_scope_must_be_leaf_branch_truth",
    "overlay_requires_source_delta_or_branch_event",
    "overlay_must_not_rewrite_base_ontology",
    "overlay_must_not_claim_shared_truth_without_delta",
    "overlay_must_not_be_pregenerated_branch_tree"
  ]
}
