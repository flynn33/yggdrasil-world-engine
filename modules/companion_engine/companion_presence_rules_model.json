{
  "rules_model_id": "companion_presence_rules.v1",
  "rules": [
    {
      "rule_id": "raven_presence_always_bound",
      "if": [
        "player_runtime_state.active == true"
      ],
      "then": [
        "require raven_companion_state_ref"
      ],
      "forbid": [
        "generic_pet_replacement",
        "default_absence"
      ]
    },
    {
      "rule_id": "wolves_require_manifestation_event",
      "if": [
        "white_wolf.present == true OR dark_wolf.present == true"
      ],
      "then": [
        "require wolf_manifestation_event_ref",
        "require trigger",
        "require duration"
      ],
      "forbid": [
        "default_party_member",
        "morality_meter"
      ]
    }
  ]
}
