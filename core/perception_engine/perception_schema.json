{
  "schema_id": "ywe.core.perception",
  "version": "2.0.0",
  "description": "Schema for the perception layer that determines player-specific world interpretation",
  "perception_state": {
    "player_id": "",
    "active_realm": "physical",
    "perception_modifiers": {
      "realm_attunement": {},
      "wolf_resonance": {
        "white_wolf": 0,
        "dark_wolf": 0
      },
      "bloodline_resonance": {},
      "narrative_memory_flags": {}
    }
  },
  "perception_overlay": {
    "location_id": "",
    "base_description": "",
    "perceived_description": "",
    "npc_variants": [],
    "vendor_variants": [],
    "quest_giver_variants": [],
    "visible_entities": [],
    "hidden_entities": []
  },
  "perception_rules": {
    "base_ontology_is_immutable": true,
    "scoped_worldstate_may_change": true,
    "objective_state_change_requires_accepted_delta": true,
    "perception_is_derived_view": true,
    "world_is_static": true,
    "perception_is_player_specific": true,
    "multiplayer_compatible": true,
    "same_location_different_views": true
  },
  "terminology_compatibility": {
    "world_is_static": {
      "status": "deprecated",
      "canonical_rule": "base_ontology_is_immutable",
      "interpretation": "The legacy true value applies only to base ontology; it does not prohibit scoped worldstate transitions."
    },
    "wolf_alignment": {
      "status": "deprecated",
      "canonical_field": "wolf_resonance",
      "legacy_read_behavior": "resolve_as_wolf_resonance",
      "dual_field_requirement": "white_wolf_and_dark_wolf_values_must_match",
      "conflict_behavior": "reject_record",
      "canonical_write_target": "wolf_resonance",
      "creates_independent_state": false
    }
  },
  "ash_alignment_contract": {
    "authority": "YWE_ASP_CORE_MATH_REBUILD_PACKAGE",
    "math_basis": "F2^9 full-state ASH vector with exactly 16 canonical codewords and x' = x XOR c transitions",
    "required_inputs": [
      "CosmicPatternSnapshot",
      "DiagnosticEnvelope"
    ],
    "required_materialization": "GenerationPlan",
    "provenance_fields": [
      "cosmic_pattern_snapshot_ref",
      "diagnostic_ref",
      "generation_plan_ref",
      "source_ash_refs"
    ],
    "truth_boundary": "GenerationPlan may guide materialization; downstream engines and adapters must not author ASH truth or YWE domain truth.",
    "records": [
      "PerceptionStateRecord",
      "OverlayManifest",
      "VisibilityRules",
      "truth_substrate_ref",
      "perception_overlay_does_not_rewrite_shared_world_truth",
      "geography_rewrite"
    ]
  },
  "ash_required_fields": {
    "cosmic_pattern_snapshot_ref": "CosmicPatternSnapshot",
    "diagnostic_ref": "DiagnosticEnvelope",
    "generation_plan_ref": "GenerationPlan",
    "source_ash_refs": "SourceASHRefs"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/core/perception_engine/perception_schema.json",
  "title": "Perception Schema",
  "x-ywe-requirement-id": "YWE-M2-SCHEMA-CORE-PERCEPTION-ENGINE-PERCEPTION-SCHEMA-JSON",
  "type": "object",
  "required": [
    "perception_state",
    "perception_overlay",
    "perception_rules",
    "terminology_compatibility",
    "ash_required_fields"
  ],
  "properties": {
    "perception_state": {
      "type": "object",
      "properties": {
        "player_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "active_realm": {
          "type": "string",
          "minLength": 1
        },
        "perception_modifiers": {
          "type": "object",
          "properties": {
            "realm_attunement": {
              "type": "object",
              "properties": {},
              "additionalProperties": true
            },
            "wolf_resonance": {
              "type": "object",
              "properties": {
                "white_wolf": {
                  "type": "integer"
                },
                "dark_wolf": {
                  "type": "integer"
                }
              },
              "additionalProperties": true
            },
            "bloodline_resonance": {
              "type": "object",
              "properties": {},
              "additionalProperties": true
            },
            "narrative_memory_flags": {
              "type": "object",
              "properties": {},
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "perception_overlay": {
      "type": "object",
      "properties": {
        "location_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "base_description": {
          "type": "string",
          "minLength": 1
        },
        "perceived_description": {
          "type": "string",
          "minLength": 1
        },
        "npc_variants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "vendor_variants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "quest_giver_variants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "visible_entities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hidden_entities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "perception_rules": {
      "type": "object",
      "properties": {
        "base_ontology_is_immutable": {
          "type": "boolean"
        },
        "scoped_worldstate_may_change": {
          "type": "boolean"
        },
        "objective_state_change_requires_accepted_delta": {
          "type": "boolean"
        },
        "perception_is_derived_view": {
          "type": "boolean"
        },
        "world_is_static": {
          "type": "boolean"
        },
        "perception_is_player_specific": {
          "type": "boolean"
        },
        "multiplayer_compatible": {
          "type": "boolean"
        },
        "same_location_different_views": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "terminology_compatibility": {
      "type": "object",
      "properties": {
        "world_is_static": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "minLength": 1
            },
            "canonical_rule": {
              "type": "string",
              "minLength": 1
            },
            "interpretation": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "wolf_alignment": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "minLength": 1
            },
            "canonical_field": {
              "type": "string",
              "minLength": 1
            },
            "legacy_read_behavior": {
              "type": "string",
              "minLength": 1
            },
            "dual_field_requirement": {
              "type": "string",
              "minLength": 1
            },
            "conflict_behavior": {
              "type": "string",
              "minLength": 1
            },
            "canonical_write_target": {
              "type": "string",
              "minLength": 1
            },
            "creates_independent_state": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "ash_required_fields": {
      "type": "object",
      "properties": {
        "cosmic_pattern_snapshot_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "diagnostic_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "generation_plan_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "source_ash_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
