{
  "schema_id": "ywe.core.ash_pattern",
  "version": "2.0.0",
  "description": "Schema for ASH cosmic pattern detection and generation",
  "pattern_node": {
    "pattern_id": "",
    "type": "",
    "realm_bias": "",
    "strength": 0,
    "type_options": [
      "hidden_knowledge",
      "revelation",
      "cosmic_imbalance",
      "ancestral_echo",
      "prophecy_seed",
      "myth_catalyst",
      "artifact_emergence",
      "creature_manifestation",
      "civilization_shift",
      "divine_intervention"
    ]
  },
  "pattern_generation_rules": {
    "source": "ash_cosmological_state",
    "independent_random_allowed": false,
    "must_derive_from_cosmic_state": true
  },
  "pattern_outputs": [
    "quest_seed",
    "artifact_seed",
    "creature_seed",
    "myth_seed",
    "prophecy_seed",
    "narrative_space_seed"
  ],
  "ash_state_space_contract": {
    "authority": "YWE_ASP_CORE_MATH_REBUILD_PACKAGE",
    "math_basis": "F2^9 full-state ASH vector with exactly 16 canonical codewords and x' = x XOR c transitions",
    "required_inputs": [
      "CosmicPatternSnapshot",
      "DiagnosticEnvelope"
    ],
    "required_materialization": "GenerationPlan",
    "provenance_fields": [
      "cosmic_pattern_snapshot_ref",
      "diagnostic_ref",
      "generation_plan_ref",
      "source_ash_refs"
    ],
    "truth_boundary": "GenerationPlan may guide materialization; downstream engines and adapters must not author ASH truth or YWE domain truth.",
    "AshState": {
      "coordinates": 9,
      "field": "F2",
      "state_count": 512
    },
    "CanonicalCodewordSet": {
      "count": 16,
      "transition": "x' = x XOR c"
    },
    "CosmicPatternSnapshot": {
      "required_fields": [
        "source_orbit_id",
        "active_codeword_sequence",
        "diagnostic_ref",
        "generation_plan_ref"
      ]
    },
    "DiagnosticEnvelope": {
      "required_fields": [
        "diagnostic_ref",
        "rule_id",
        "status",
        "source_ash_refs"
      ]
    },
    "GenerationPlan": {
      "required_fields": [
        "generation_plan_ref",
        "cosmic_pattern_snapshot_ref",
        "diagnostic_ref",
        "target_domain"
      ]
    }
  }
}
