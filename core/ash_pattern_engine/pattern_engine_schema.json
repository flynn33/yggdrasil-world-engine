{
  "schema_id": "ywe.core.ash_pattern",
  "version": "2.0.0",
  "description": "Schema for ASH cosmic pattern detection and generation",
  "pattern_node": {
    "pattern_id": "",
    "type": "",
    "realm_bias": "",
    "strength": 0,
    "type_options": [
      "hidden_knowledge",
      "revelation",
      "cosmic_imbalance",
      "ancestral_echo",
      "prophecy_seed",
      "myth_catalyst",
      "artifact_emergence",
      "creature_manifestation",
      "civilization_shift",
      "divine_intervention"
    ]
  },
  "pattern_generation_rules": {
    "source": "ash_cosmological_state",
    "independent_random_allowed": false,
    "must_derive_from_cosmic_state": true
  },
  "pattern_outputs": [
    "quest_seed",
    "artifact_seed",
    "creature_seed",
    "myth_seed",
    "prophecy_seed",
    "narrative_space_seed"
  ],
  "ash_state_space_contract": {
    "authority": "YWE_ASP_CORE_MATH_REBUILD_PACKAGE",
    "math_basis": "F2^9 full-state ASH vector with exactly 16 canonical codewords and x' = x XOR c transitions",
    "required_inputs": [
      "CosmicPatternSnapshot",
      "DiagnosticEnvelope"
    ],
    "required_materialization": "GenerationPlan",
    "provenance_fields": [
      "cosmic_pattern_snapshot_ref",
      "diagnostic_ref",
      "generation_plan_ref",
      "source_ash_refs"
    ],
    "truth_boundary": "GenerationPlan may guide materialization; downstream engines and adapters must not author ASH truth or YWE domain truth.",
    "AshState": {
      "coordinates": 9,
      "field": "F2",
      "state_count": 512
    },
    "CanonicalCodewordSet": {
      "count": 16,
      "transition": "x' = x XOR c"
    },
    "CosmicPatternSnapshot": {
      "required_fields": [
        "source_orbit_id",
        "active_codeword_sequence",
        "diagnostic_ref",
        "generation_plan_ref"
      ]
    },
    "DiagnosticEnvelope": {
      "required_fields": [
        "diagnostic_ref",
        "rule_id",
        "status",
        "source_ash_refs"
      ]
    },
    "GenerationPlan": {
      "required_fields": [
        "generation_plan_ref",
        "cosmic_pattern_snapshot_ref",
        "diagnostic_ref",
        "target_domain"
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ywe.local/schemas/core/ash_pattern_engine/pattern_engine_schema.json",
  "title": "Pattern Engine Schema",
  "x-ywe-requirement-id": "YWE-M2-SCHEMA-CORE-ASH-PATTERN-ENGINE-PATTERN-ENGINE-SCHEMA-JSON",
  "type": "object",
  "required": [
    "pattern_node",
    "pattern_generation_rules",
    "pattern_outputs",
    "ash_state_space_contract"
  ],
  "properties": {
    "pattern_node": {
      "type": "object",
      "properties": {
        "pattern_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "realm_bias": {
          "type": "string",
          "minLength": 1
        },
        "strength": {
          "type": "number"
        },
        "type_options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "pattern_generation_rules": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "independent_random_allowed": {
          "type": "boolean"
        },
        "must_derive_from_cosmic_state": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "pattern_outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ash_state_space_contract": {
      "type": "object",
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "math_basis": {
          "type": "string",
          "minLength": 1
        },
        "required_inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_materialization": {
          "type": "string",
          "minLength": 1
        },
        "provenance_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "truth_boundary": {
          "type": "string",
          "minLength": 1
        },
        "AshState": {
          "type": "object",
          "properties": {
            "coordinates": {
              "type": "integer"
            },
            "field": {
              "type": "string",
              "minLength": 1
            },
            "state_count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        "CanonicalCodewordSet": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "transition": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "CosmicPatternSnapshot": {
          "type": "object",
          "properties": {
            "required_fields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": true
        },
        "DiagnosticEnvelope": {
          "type": "object",
          "properties": {
            "required_fields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": true
        },
        "GenerationPlan": {
          "type": "object",
          "properties": {
            "required_fields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
