    "MODULE_ORIGIN_DIAGNOSE",
    "PURE_MODULE_COMPUTE",
    "MODULE_CAPTURE_BEGIN",
    "MODULE_FINAL_OBSERVATION"
  ],
  "fresh_context_derivation": {
    "assessment_reference": "request_reference + :module:origin:assessment",
    "original_input_reference": "request_reference + :module:origin:input",
    "detection_reference": "request_reference + :module:origin:detection",
    "classification_reference": "request_reference + :module:origin:classification (never emitted by diagnose)"
  },
  "constraints": [
    "producer/operation/arguments exact mapped union; no untrusted type equality/hash/coercion hooks",
    "Axiom subject state equals captured admitted state and provenance origin ref equals deterministic fresh diagnosis detection; do not rebind caller evidence",
    "dependencies resolve only previous complete owner-retained entries and actual original result identities, current full binding/profile and first/final actual capture truth",
    "actual_pure_result retained once in API DAG; actual_pure_result wire field must be null when module_capture is present, avoiding an extra duplicate serialized packet",
    "SessionModuleHistory control_observations has exactly one correlated response or null per results entry; its actual final response is external to the immutable session link and preserves unknown status",
    "SessionHistory gains optional module_history omitted when None; original constructor positions and fields preserved for historic pair",
    "Control reservation does not observe clock, allocate aliases or write store during preflight; refused acquisition returns unconfirmed no scope. Actual issued control scope always gets once final attempt, also after seal.",
    "Every actual scope retained independent of receipt status; first receipt/partial prefix immutable. Admission/result claims effects false even after pure candidate construction."
  ],
  "api_only_constructor_clarifications": [
    {
      "owner": "SessionRetentionReceipt",
      "keyword_only_context": "policy_binding:SessionPolicyBinding|None=None",
