    "SessionModuleControlScope": "API_ONLY_issued_exact_collector_session_gate_private_final_receipt_once"
  },
  "public_ports": [
    [
      "ReferenceSessionLifecycle.__init__",
      "existing three arguments plus keyword-only module_owners=(); exact bounded tuple of at most one original instance of each eligible producer class; omitted tuple preserves historical assembly"
    ],
    [
      "RecoveryEngine.execute_session_module",
      "(session,command)->SessionModuleExecutionObservation|SessionModuleRawFailure|SessionDeniedAttempt|SessionModuleReplayObservation"
    ],
    [
      "RecoveryEngine.read_session_module_history",
      "(session)->SessionModuleHistory"
    ],
    [
      "Diagnostics.reserve_session_module",
      "(handle,lease,*,execution_gate)->SessionModuleCaptureAdmission"
    ],
    [
      "SessionModuleControlScope.observe_final",
      "(actual_result)->SessionModuleRetentionReceipt"
    ],
    [
      "Diagnostics.pin_session_module_history",
      "(handle,history)->SessionModuleRetentionReceipt"
    ],
    [
      "Diagnostics.freeze_terminal",
      "existing signature plus keyword module_history=None; omitted None preserves old exact calls/shapes"
    ],
    [
      "Diagnostics.module_capture",
      "(producer,context,*,execution_gate=None,emitter_control=None); existing port admits exact current-pair module gate; Core/emitter branch separately governed; independent capture pre/post checks"
    ],
    [
      "SessionExecutionGate.validate_module_capture",
      "class-owned (gate,collector,operation_reference,producer)->exact bool; original issued MODULE lease/current complete source-policy/collector/operation/producer metadata only; no owner entry or IO"
    ],
    [
      "session_values.wire_schema",
      "class-owned exact-owned-root/full source-policy dispatch to unchanged historical schema or new current-source schema; no caller schema selector"
    ]
  ],
  "unchanged_pure_public_ports": [
    "RealmEncoder.encode",
    "TransitionRegistry.resolve",
    "TransitionRegistry.apply",
    "ReferenceTopologyGenerator.generate",
    "ReferenceAxiomEvaluator.evaluate",
    "configuration",
    "validate_owned_result"
